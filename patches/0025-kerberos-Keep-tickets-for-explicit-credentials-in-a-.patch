From 1f8aaa806d64ddfc6093fc91210ce2f8d8c9f1e9 Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sun, 15 Nov 2026 14:08:49 -0500
Subject: [PATCH 25/43] kerberos: Keep tickets for explicit credentials in a
 memory cache.

AcquireCredentialsHandle with a user name and password stored the new ticket-granting
ticket in the default credential cache, replacing the user's tickets there and leaving
the ticket on disk. Use a new memory cache per credential handle when the libraries
support it, as Windows keeps such tickets in the logon session.
---
 dlls/kerberos/unixlib.c | 47 +++++++++++++++++++++++++++++++++++------
 1 file changed, 41 insertions(+), 6 deletions(-)

diff --git a/dlls/kerberos/unixlib.c b/dlls/kerberos/unixlib.c
index d75c044..e262bee 100644
--- a/dlls/kerberos/unixlib.c
+++ b/dlls/kerberos/unixlib.c
@@ -63,6 +63,9 @@ static void *libkrb5_handle;
 
 #define MAKE_FUNCPTR(f) static typeof(f) * p_##f
 MAKE_FUNCPTR( krb5_cc_close );
+static typeof(krb5_cc_new_unique) *p_krb5_cc_new_unique;       /* optional */
+static typeof(krb5_cc_get_full_name) *p_krb5_cc_get_full_name; /* optional */
+static typeof(krb5_free_string) *p_krb5_free_string;           /* optional */
 MAKE_FUNCPTR( krb5_cc_default );
 MAKE_FUNCPTR( krb5_cc_end_seq_get );
 MAKE_FUNCPTR( krb5_cc_initialize );
@@ -104,6 +107,9 @@ static BOOL load_krb5(void)
     }
 
     LOAD_FUNCPTR( krb5_cc_close )
+    p_krb5_cc_new_unique = dlsym( libkrb5_handle, "krb5_cc_new_unique" );
+    p_krb5_cc_get_full_name = dlsym( libkrb5_handle, "krb5_cc_get_full_name" );
+    p_krb5_free_string = dlsym( libkrb5_handle, "krb5_free_string" );
     LOAD_FUNCPTR( krb5_cc_default )
     LOAD_FUNCPTR( krb5_cc_end_seq_get )
     LOAD_FUNCPTR( krb5_cc_initialize )
@@ -397,6 +403,7 @@ static void *libgssapi_krb5_handle;
 #define MAKE_FUNCPTR(f) static typeof(f) * p##f
 MAKE_FUNCPTR( gss_accept_sec_context );
 MAKE_FUNCPTR( gss_acquire_cred );
+static typeof(gss_acquire_cred_from) *pgss_acquire_cred_from; /* optional */
 MAKE_FUNCPTR( gss_delete_sec_context );
 MAKE_FUNCPTR( gss_display_status );
 MAKE_FUNCPTR( gss_get_mic );
@@ -434,6 +441,7 @@ static BOOL load_gssapi_krb5(void)
 
     LOAD_FUNCPTR( gss_accept_sec_context )
     LOAD_FUNCPTR( gss_acquire_cred )
+    pgss_acquire_cred_from = dlsym( libgssapi_krb5_handle, "gss_acquire_cred_from" );
     LOAD_FUNCPTR( gss_delete_sec_context )
     LOAD_FUNCPTR( gss_display_status )
     LOAD_FUNCPTR( gss_get_mic )
@@ -604,7 +612,11 @@ static NTSTATUS accept_context( void *args )
     return status_gss_to_sspi( ret );
 }
 
-static NTSTATUS init_creds( const char *user_at_domain, const char *password )
+/* Get a ticket-granting ticket for explicit credentials. It goes into a new in-memory
+ * cache when the libraries support it (its name is returned in ccache_name, which the
+ * caller frees with p_krb5_free_string), as Windows keeps such tickets in the logon
+ * session; otherwise into the default cache, replacing the user's tickets there. */
+static NTSTATUS init_creds( const char *user_at_domain, const char *password, char **ccache_name )
 {
     krb5_context ctx;
     krb5_principal principal = NULL;
@@ -616,13 +628,21 @@ static NTSTATUS init_creds( const char *user_at_domain, const char *password )
     if (!user_at_domain) return STATUS_SUCCESS;
     if ((err = p_krb5_init_context( &ctx ))) return krb5_error_to_status( err );
     if ((err = p_krb5_parse_name_flags( ctx, user_at_domain, 0, &principal ))) goto done;
-    if ((err = p_krb5_cc_default( ctx, &cache ))) goto done;
+    if (ccache_name && p_krb5_cc_new_unique && p_krb5_cc_get_full_name && p_krb5_free_string && pgss_acquire_cred_from)
+    {
+        if ((err = p_krb5_cc_new_unique( ctx, "MEMORY", NULL, &cache ))) goto done;
+    }
+    else if ((err = p_krb5_cc_default( ctx, &cache ))) goto done;
     if ((err = p_krb5_get_init_creds_opt_alloc( ctx, &options ))) goto done;
     if ((err = p_krb5_get_init_creds_opt_set_out_ccache( ctx, options, cache ))) goto done;
     if ((err = p_krb5_get_init_creds_password( ctx, &creds, principal, password, 0, NULL, 0, NULL, 0 ))) goto done;
     if ((err = p_krb5_cc_initialize( ctx, cache, principal ))) goto done;
     if ((err = p_krb5_cc_store_cred( ctx, cache, &creds ))) goto done;
 
+    if (ccache_name && p_krb5_cc_new_unique && p_krb5_cc_get_full_name && p_krb5_free_string && pgss_acquire_cred_from &&
+        (err = p_krb5_cc_get_full_name( ctx, cache, ccache_name )))
+        goto done;
+
     TRACE( "success\n" );
     p_krb5_free_cred_contents( ctx, &creds );
 
@@ -677,6 +697,7 @@ static NTSTATUS acquire_credentials_handle( void *args )
     gss_name_t name = GSS_C_NO_NAME;
     gss_cred_usage_t cred_usage;
     gss_cred_id_t cred_handle;
+    char *ccache_name = NULL;
     NTSTATUS status;
 
     switch (params->credential_use)
@@ -687,7 +708,7 @@ static NTSTATUS acquire_credentials_handle( void *args )
 
     case SECPKG_CRED_BOTH:
     case SECPKG_CRED_OUTBOUND:
-        if ((status = init_creds( params->username, params->password )) != STATUS_SUCCESS) return status;
+        if ((status = init_creds( params->username, params->password, &ccache_name )) != STATUS_SUCCESS) return status;
         cred_usage = params->credential_use == SECPKG_CRED_OUTBOUND ? GSS_C_INITIATE : GSS_C_BOTH;
         break;
 
@@ -695,10 +716,24 @@ static NTSTATUS acquire_credentials_handle( void *args )
         return SEC_E_UNKNOWN_CREDENTIALS;
     }
 
-    if (params->principal && (status = import_name( params->principal, &name ))) return status;
+    if (params->principal && (status = import_name( params->principal, &name )))
+    {
+        if (ccache_name) p_krb5_free_string( NULL, ccache_name );
+        return status;
+    }
+
+    if (ccache_name)
+    {
+        gss_key_value_element_desc element = { "ccache", ccache_name };
+        gss_key_value_set_desc store = { 1, &element };
 
-    ret = pgss_acquire_cred( &minor_status, name, GSS_C_INDEFINITE, GSS_C_NULL_OID_SET, cred_usage, &cred_handle,
-                             NULL, &expiry_time );
+        ret = pgss_acquire_cred_from( &minor_status, name, GSS_C_INDEFINITE, GSS_C_NULL_OID_SET, cred_usage,
+                                      &store, &cred_handle, NULL, &expiry_time );
+        p_krb5_free_string( NULL, ccache_name );
+    }
+    else
+        ret = pgss_acquire_cred( &minor_status, name, GSS_C_INDEFINITE, GSS_C_NULL_OID_SET, cred_usage, &cred_handle,
+                                 NULL, &expiry_time );
     TRACE( "gss_acquire_cred returned %#x minor status %#x\n", ret, minor_status );
     if (GSS_ERROR( ret )) trace_gss_status( ret, minor_status );
     if (ret == GSS_S_COMPLETE)
-- 
2.47.3

