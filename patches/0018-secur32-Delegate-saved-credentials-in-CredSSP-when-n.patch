From df43c04c534b1e76ca27e2e137514537dea90646 Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sat, 14 Nov 2026 21:02:51 -0500
Subject: [PATCH 18/18] secur32: Delegate saved credentials in CredSSP when
 none are supplied.

The Remote Desktop client saves "Remember my password" credentials as
CRED_TYPE_DOMAIN_PASSWORD named after the target SPN (TERMSRV/host) and
on later connections passes no credentials to CredSSP, relying on it to
find them.  Without them NTLM ran as the current user and the server
showed its own logon screen.

Like Windows' default policy (AllowSavedCredentials and
AllowSavedCredentialsWhenNTLMOnly), this is limited to TERMSRV/ targets.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/secur32/credssp.c | 94 +++++++++++++++++++++++++++++++++---------
 1 file changed, 75 insertions(+), 19 deletions(-)

diff --git a/dlls/secur32/credssp.c b/dlls/secur32/credssp.c
index 926d2613..bb9c4c43 100644
--- a/dlls/secur32/credssp.c
+++ b/dlls/secur32/credssp.c
@@ -100,6 +100,7 @@ struct credssp_ctx
     BOOL     tls_valid;
     BOOL     nego_valid;
     BOOL     nego_done;
+    struct credssp_cred *saved; /* credentials from the credential manager, if the caller gave none */
     WCHAR   *spn;
     WCHAR   *host;
     ULONG    req;
@@ -510,6 +511,73 @@ static struct credssp_cred *get_cred( PCredHandle handle )
     return cred->magic == CREDSSP_CRED_MAGIC ? cred : NULL;
 }
 
+/* The credentials a context authenticates and delegates with. */
+static struct credssp_cred *ctx_cred( const struct credssp_ctx *ctx )
+{
+    return ctx->saved ? ctx->saved : ctx->cred;
+}
+
+static SECURITY_STATUS acquire_nego( struct credssp_cred *cred )
+{
+    SEC_WINNT_AUTH_IDENTITY_W id = { 0 };
+    SECURITY_STATUS status;
+
+    if (cred->user)
+    {
+        id.User = (unsigned short *)cred->user;
+        id.UserLength = wcslen( cred->user );
+        id.Domain = (unsigned short *)cred->domain;
+        id.DomainLength = cred->domain ? wcslen( cred->domain ) : 0;
+        id.Password = (unsigned short *)cred->password;
+        id.PasswordLength = cred->password ? wcslen( cred->password ) : 0;
+        id.Flags = SEC_WINNT_AUTH_IDENTITY_UNICODE;
+    }
+    status = AcquireCredentialsHandleW( NULL, (SEC_WCHAR *)L"Negotiate", SECPKG_CRED_OUTBOUND, NULL,
+                                        cred->user ? &id : NULL, NULL, NULL, &cred->nego, NULL );
+    if (status) WARN( "Negotiate credentials failed %#lx\n", status );
+    else cred->have_nego = TRUE;
+    return status;
+}
+
+/* Without explicit credentials, Windows delegates the credentials saved for the target
+ * (CRED_TYPE_DOMAIN_PASSWORD named after the SPN, as the Remote Desktop client stores them).
+ * Its default policy (AllowSavedCredentials, AllowSavedCredentialsWhenNTLMOnly) allows this
+ * for TERMSRV/ targets only. */
+static struct credssp_cred *load_saved_cred( const WCHAR *spn )
+{
+    struct credssp_cred *saved;
+    CREDENTIALW *c;
+    WCHAR *sep;
+
+    if (!spn || wcsnicmp( spn, L"TERMSRV/", 8 )) return NULL;
+    if (!CredReadW( spn, CRED_TYPE_DOMAIN_PASSWORD, 0, &c )) return NULL;
+    if (!c->UserName || !c->CredentialBlobSize || (c->CredentialBlobSize % sizeof(WCHAR)) ||
+        !(saved = calloc( 1, sizeof(*saved) )))
+    {
+        TRACE( "no usable saved credentials for %s\n", debugstr_w(spn) );
+        CredFree( c );
+        return NULL;
+    }
+    saved->magic = CREDSSP_CRED_MAGIC;
+    saved->user = strdupW_len( c->UserName, wcslen( c->UserName ) );
+    saved->password = strdupW_len( (const WCHAR *)c->CredentialBlob, c->CredentialBlobSize / sizeof(WCHAR) );
+    SecureZeroMemory( c->CredentialBlob, c->CredentialBlobSize );
+    CredFree( c );
+    if (saved->user && (sep = wcschr( saved->user, '\\' )))
+    {
+        saved->domain = strdupW_len( saved->user, sep - saved->user );
+        memmove( saved->user, sep + 1, (wcslen( sep + 1 ) + 1) * sizeof(WCHAR) );
+    }
+    if (!saved->user || !saved->password || acquire_nego( saved ))
+    {
+        free_cred( saved );
+        return NULL;
+    }
+    TRACE( "using saved credentials for %s: user %s domain %s\n", debugstr_w(spn),
+           debugstr_w(saved->user), debugstr_w(saved->domain) );
+    return saved;
+}
+
 static struct credssp_ctx *get_ctx( PCtxtHandle handle )
 {
     struct credssp_ctx *ctx;
@@ -684,7 +752,7 @@ static SECURITY_STATUS nego_step( struct credssp_ctx *ctx, const BYTE *in, DWORD
     ULONG attrs;
     SECURITY_STATUS status;
 
-    status = InitializeSecurityContextW( &ctx->cred->nego, ctx->nego_valid ? &ctx->nego : NULL, ctx->spn,
+    status = InitializeSecurityContextW( &ctx_cred( ctx )->nego, ctx->nego_valid ? &ctx->nego : NULL, ctx->spn,
                                          ISC_REQ_ALLOCATE_MEMORY | ISC_REQ_MUTUAL_AUTH | ISC_REQ_CONFIDENTIALITY |
                                          ISC_REQ_INTEGRITY | ISC_REQ_SEQUENCE_DETECT | ISC_REQ_REPLAY_DETECT |
                                          ISC_REQ_USE_SESSION_KEY,
@@ -815,7 +883,7 @@ static SECURITY_STATUS start_nego( struct credssp_ctx *ctx, struct blob *out )
     if (BCryptGenRandom( NULL, ctx->nonce, sizeof(ctx->nonce), BCRYPT_USE_SYSTEM_PREFERRED_RNG ))
         return SEC_E_INTERNAL_ERROR;
 
-    if (!ctx->cred->have_nego) return SEC_E_NO_CREDENTIALS;
+    if (!ctx_cred( ctx )->have_nego) return SEC_E_NO_CREDENTIALS;
     if ((status = nego_step( ctx, NULL, 0, &token ))) return status;
     if (ctx->nego_done)
     {
@@ -870,13 +938,13 @@ static SECURITY_STATUS process_ts_request( struct credssp_ctx *ctx, const struct
     }
     if (!req->pubkey_auth.len) return SEC_E_INVALID_TOKEN;
     if ((status = check_pubkey_auth( ctx, &req->pubkey_auth ))) goto done;
-    if (!ctx->cred->password)
+    if (!ctx_cred( ctx )->password)
     {
         FIXME( "no password to delegate\n" );
         status = SEC_E_NO_CREDENTIALS;
         goto done;
     }
-    if (!build_ts_credentials( ctx->cred, &creds )) { status = SEC_E_INSUFFICIENT_MEMORY; goto done; }
+    if (!build_ts_credentials( ctx_cred( ctx ), &creds )) { status = SEC_E_INSUFFICIENT_MEMORY; goto done; }
     status = nego_encrypt( ctx, creds.data, creds.len, &info );
     SecureZeroMemory( creds.data, creds.len );
     free_blob( &creds );
@@ -974,7 +1042,6 @@ static SECURITY_STATUS SEC_ENTRY credssp_AcquireCredentialsHandleW( SEC_WCHAR *p
 {
     const CREDSSP_CRED *in = auth_data;
     SCHANNEL_CRED schan = { SCHANNEL_CRED_VERSION };
-    SEC_WINNT_AUTH_IDENTITY_W id = { 0 };
     struct credssp_cred *cred;
     CREDSPP_SUBMIT_TYPE type = 0;
     SECURITY_STATUS status;
@@ -1025,20 +1092,7 @@ static SECURITY_STATUS SEC_ENTRY credssp_AcquireCredentialsHandleW( SEC_WCHAR *p
         return status;
     }
 
-    if (cred->user)
-    {
-        id.User = (unsigned short *)cred->user;
-        id.UserLength = wcslen( cred->user );
-        id.Domain = (unsigned short *)cred->domain;
-        id.DomainLength = cred->domain ? wcslen( cred->domain ) : 0;
-        id.Password = (unsigned short *)cred->password;
-        id.PasswordLength = cred->password ? wcslen( cred->password ) : 0;
-        id.Flags = SEC_WINNT_AUTH_IDENTITY_UNICODE;
-    }
-    status = AcquireCredentialsHandleW( NULL, (SEC_WCHAR *)L"Negotiate", SECPKG_CRED_OUTBOUND, NULL,
-                                        cred->user ? &id : NULL, NULL, NULL, &cred->nego, NULL );
-    if (status) WARN( "Negotiate credentials failed %#lx\n", status );
-    else cred->have_nego = TRUE;
+    acquire_nego( cred );
 
     handle->dwLower = (ULONG_PTR)cred;
     handle->dwUpper = 0;
@@ -1066,6 +1120,7 @@ static void free_ctx( struct credssp_ctx *ctx )
 {
     if (ctx->tls_valid) DeleteSecurityContext( &ctx->tls );
     if (ctx->nego_valid) DeleteSecurityContext( &ctx->nego );
+    if (ctx->saved) free_cred( ctx->saved );
     free( ctx->spn );
     free( ctx->host );
     free( ctx->pubkey );
@@ -1106,6 +1161,7 @@ static SECURITY_STATUS SEC_ENTRY credssp_InitializeSecurityContextW( PCredHandle
             if (ctx->host && (host = wcschr( ctx->host, ':' ))) ctx->host[host - ctx->host] = 0;
         }
         if (target && (!ctx->spn || !ctx->host)) { free_ctx( ctx ); return SEC_E_INSUFFICIENT_MEMORY; }
+        if (!cred->user) ctx->saved = load_saved_cred( ctx->spn );
         if (!new_ctx) { free_ctx( ctx ); return SEC_E_INVALID_HANDLE; }
         new_ctx->dwLower = (ULONG_PTR)ctx;
         new_ctx->dwUpper = 0;
-- 
2.47.3

