+WINADVAPI BOOL  WINAPI CredUnprotectA(BOOL,LPSTR,DWORD,LPSTR,DWORD *);
+WINADVAPI BOOL  WINAPI CredUnprotectW(BOOL,LPWSTR,DWORD,LPWSTR,DWORD *);
