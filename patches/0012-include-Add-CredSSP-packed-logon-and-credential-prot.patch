+WINADVAPI BOOL  WINAPI CredIsProtectedA(LPSTR,CRED_PROTECTION_TYPE *);
+WINADVAPI BOOL  WINAPI CredIsProtectedW(LPWSTR,CRED_PROTECTION_TYPE *);
