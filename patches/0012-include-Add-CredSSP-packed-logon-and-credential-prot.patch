diff --git a/include/credssp.h b/include/credssp.h
new file mode 100644
index 0000000..76efe39
--- /dev/null
+++ b/include/credssp.h
@@ -0,0 +1,62 @@
+/*
+ * Credential Security Support Provider (CredSSP) definitions
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_CREDSSP_H
+#define __WINE_CREDSSP_H
+
+#define CREDSSP_NAME  L"CREDSSP"
+#define TS_SSP_NAME_A "TSSSP"
+#define TS_SSP_NAME   L"TSSSP"
+
+#define CREDSSP_SERVER_AUTH_NEGOTIATE   0x1
+#define CREDSSP_SERVER_AUTH_CERTIFICATE 0x2
+#define CREDSSP_SERVER_AUTH_LOOPBACK    0x4
+
+#define SECPKG_ALT_ATTR                 0x80000000
+#define SECPKG_ATTR_C_FULL_IDENT_TOKEN  (SECPKG_ALT_ATTR | 0x00000085)
+
+typedef enum _CREDSPP_SUBMIT_TYPE
+{
+    CredsspPasswordCreds = 2,
+    CredsspSchannelCreds = 4,
+    CredsspCertificateCreds = 13,
+    CredsspSubmitBufferBoth = 50,
+    CredsspSubmitBufferBothOld = 51,
+    CredsspCredEx = 100
+} CREDSPP_SUBMIT_TYPE;
+
+typedef struct _CREDSSP_CRED
+{
+    CREDSPP_SUBMIT_TYPE Type;
+    void *pSchannelCred;
+    void *pSpnegoCred;
+} CREDSSP_CRED, *PCREDSSP_CRED;
+
+#define CREDSSP_CRED_EX_VERSION          0
+#define CREDSSP_FLAG_REDIRECT            0x1
+
+typedef struct _CREDSSP_CRED_EX
+{
+    CREDSPP_SUBMIT_TYPE Type;
+    ULONG Version;
+    ULONG Flags;
+    ULONG Reserved;
+    CREDSSP_CRED Cred;
+} CREDSSP_CRED_EX, *PCREDSSP_CRED_EX;
+
+#endif /* __WINE_CREDSSP_H */
diff --git a/include/ntsecapi.h b/include/ntsecapi.h
index d01c04c..7dc5fd1 100644
--- a/include/ntsecapi.h
+++ b/include/ntsecapi.h
@@ -476,6 +476,37 @@ typedef enum _KERB_PROTOCOL_MESSAGE_TYPE
     KerbQueryS4U2ProxyCacheMessage
 } KERB_PROTOCOL_MESSAGE_TYPE, *PKERB_PROTOCOL_MESSAGE_TYPE;
 
+typedef enum _KERB_LOGON_SUBMIT_TYPE
+{
+    KerbInteractiveLogon = 2,
+    KerbSmartCardLogon = 6,
+    KerbWorkstationUnlockLogon = 7,
+    KerbSmartCardUnlockLogon = 8,
+    KerbProxyLogon = 9,
+    KerbTicketLogon = 10,
+    KerbTicketUnlockLogon = 11,
+    KerbS4ULogon = 12,
+    KerbCertificateLogon = 13,
+    KerbCertificateS4ULogon = 14,
+    KerbCertificateUnlockLogon = 15,
+    KerbNoElevationLogon = 83,
+    KerbLuidLogon = 84
+} KERB_LOGON_SUBMIT_TYPE, *PKERB_LOGON_SUBMIT_TYPE;
+
+typedef struct _KERB_INTERACTIVE_LOGON
+{
+    KERB_LOGON_SUBMIT_TYPE MessageType;
+    UNICODE_STRING LogonDomainName;
+    UNICODE_STRING UserName;
+    UNICODE_STRING Password;
+} KERB_INTERACTIVE_LOGON, *PKERB_INTERACTIVE_LOGON;
+
+typedef struct _KERB_INTERACTIVE_UNLOCK_LOGON
+{
+    KERB_INTERACTIVE_LOGON Logon;
+    LUID LogonId;
+} KERB_INTERACTIVE_UNLOCK_LOGON, *PKERB_INTERACTIVE_UNLOCK_LOGON;
+
 typedef struct _KERB_TICKET_CACHE_INFO
 {
     UNICODE_STRING ServerName;
