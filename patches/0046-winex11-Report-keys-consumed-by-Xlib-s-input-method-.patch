+++ b/dlls/winex11.drv/x11drv.h
@@ -212,6 +212,7 @@ extern INT X11DRV_ToUnicodeEx( UINT virtKey, UINT scanCode, const BYTE *lpKeySta
                                LPWSTR bufW, int bufW_size, UINT flags, HKL hkl );
 extern SHORT X11DRV_VkKeyScanEx( WCHAR wChar, HKL hkl );
 extern void X11DRV_NotifyIMEStatus( HWND hwnd, UINT status );
+extern UINT X11DRV_ImeProcessKey( HIMC himc, UINT wparam, UINT lparam, const BYTE *state );
 extern BOOL X11DRV_SetIMECompositionRect( HWND hwnd, RECT rect );
 extern void X11DRV_DestroyCursorIcon( HCURSOR handle );
 extern void X11DRV_SetCursor( HWND hwnd, HCURSOR handle );
@@ -424,6 +425,8 @@ struct x11drv_thread_data
     struct display_state pending_state;       /* display state tracking the pending / requested state */
     struct display_state current_state;       /* display state tracking the current X11 state */
     unsigned long net_active_window_serial;   /* serial of last pending _NET_ACTIVE_WINDOW request */
+    struct { UINT scan; DWORD time; } xim_keys[8]; /* key presses consumed by the input method */
+    UINT     xim_key_count;
 };
 
 extern struct x11drv_thread_data *x11drv_init_thread_data(void);
@@ -595,6 +598,7 @@ extern BOOL X11DRV_ButtonRelease( HWND hwnd, XEvent *event );
 extern BOOL X11DRV_MotionNotify( HWND hwnd, XEvent *event );
 extern BOOL X11DRV_EnterNotify( HWND hwnd, XEvent *event );
 extern BOOL X11DRV_KeyEvent( HWND hwnd, XEvent *event );
+extern void X11DRV_FilteredKeyEvent( Display *display, XEvent *event );
 extern BOOL X11DRV_KeymapNotify( HWND hwnd, XEvent *event );
 extern BOOL X11DRV_DestroyNotify( HWND hwnd, XEvent *event );
 extern BOOL X11DRV_SelectionRequest( HWND hWnd, XEvent *event );
@@ -911,6 +915,7 @@ extern struct x11drv_display_device_handler desktop_handler;
 
 /* XIM support */
 extern BOOL xim_init( const WCHAR *input_style );
+extern BOOL xim_filter_is_final(void);
 extern void xim_thread_attach( struct x11drv_thread_data *data );
 extern BOOL xim_in_compose_mode(void);
 extern void xim_set_result_string( HWND hwnd, const char *str, UINT count );
diff --git a/dlls/winex11.drv/xim.c b/dlls/winex11.drv/xim.c
index 05ef7863..755970c6 100644
--- a/dlls/winex11.drv/xim.c
+++ b/dlls/winex11.drv/xim.c
@@ -336,8 +336,32 @@ void X11DRV_NotifyIMEStatus( HWND hwnd, UINT status )
 /***********************************************************************
  *           xim_init
  */
+static BOOL xim_in_process;
+
+/* TRUE if Xlib handles input in process (its built-in compose-based input method), the way
+ * Xlib decides it: "@im=none", "@im=local", or no "@im" name. Then XFilterEvent returning
+ * TRUE means the key was consumed; an input method server (ibus, fcitx, ...) also
+ * consumes the keys it does not want and forwards them back later. */
+BOOL xim_filter_is_final(void)
+{
+    return xim_in_process;
+}
+
+static BOOL xim_name_is_in_process( const char *modifiers )
+{
+    const char *name = modifiers ? strstr( modifiers, "@im=" ) : NULL;
+    size_t len;
+
+    if (!name) return TRUE;
+    name += 4;
+    len = strcspn( name, "@" );
+    return !len || (len == 4 && !strncmp( name, "none", 4 )) || (len == 5 && !strncmp( name, "local", 5 ));
+}
+
 BOOL xim_init( const WCHAR *input_style )
 {
+    const char *modifiers;
+
     static const WCHAR offthespotW[] = {'o','f','f','t','h','e','s','p','o','t',0};
     static const WCHAR overthespotW[] = {'o','v','e','r','t','h','e','s','p','o','t',0};
     static const WCHAR rootW[] = {'r','o','o','t',0};
@@ -347,11 +371,13 @@ BOOL xim_init( const WCHAR *input_style )
         WARN("X does not support locale.\n");
         return FALSE;
     }
-    if (XSetLocaleModifiers("") == NULL)
+    if ((modifiers = XSetLocaleModifiers("")) == NULL)
     {
         WARN("Could not set locale modifiers.\n");
         return FALSE;
     }
+    xim_in_process = xim_name_is_in_process( modifiers );
+    TRACE( "modifiers %s, input method in process %d\n", debugstr_a(modifiers), xim_in_process );
 
     if (!wcsicmp( input_style, offthespotW ))
         input_style_req = XIMPreeditArea | XIMStatusArea;
