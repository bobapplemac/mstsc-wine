From 55f9fa64192af6c476ec061d69a419c6e1370186 Mon Sep 17 00:00:00 2001
From: "Andrew J. Moore" <andrew@forevermoore.net>
Date: Sat, 14 Nov 2026 10:22:32 -0500
Subject: [PATCH 08/11] advapi32: Return ERROR_NOT_FOUND from CredReadW for
 absent credential types.

CredWriteW only stores CRED_TYPE_GENERIC and CRED_TYPE_DOMAIN_PASSWORD
credentials, so a lookup of any other valid type (up to
CRED_TYPE_DOMAIN_EXTENDED) cannot find one.  Report ERROR_NOT_FOUND
instead of ERROR_INVALID_PARAMETER; the Remote Desktop client probes
CRED_TYPE_DOMAIN_EXTENDED before connecting.
---
 dlls/advapi32/cred.c       | 10 +++++++++-
 dlls/advapi32/tests/cred.c | 11 +++++++++++
 include/wincred.h          |  1 +
 3 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/dlls/advapi32/cred.c b/dlls/advapi32/cred.c
index dd8d7ce..6e6f5b6 100644
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -1257,7 +1257,7 @@ BOOL WINAPI CredReadW(LPCWSTR TargetName, DWORD Type, DWORD Flags, PCREDENTIALW
         return FALSE;
     }
 
-    if (Type != CRED_TYPE_GENERIC && Type != CRED_TYPE_DOMAIN_PASSWORD)
+    if (Type < CRED_TYPE_GENERIC || Type > CRED_TYPE_DOMAIN_EXTENDED)
     {
         FIXME("unhandled type %ld\n", Type);
         SetLastError(ERROR_INVALID_PARAMETER);
@@ -1271,6 +1271,14 @@ BOOL WINAPI CredReadW(LPCWSTR TargetName, DWORD Type, DWORD Flags, PCREDENTIALW
         return FALSE;
     }
 
+    if (Type != CRED_TYPE_GENERIC && Type != CRED_TYPE_DOMAIN_PASSWORD)
+    {
+        /* CredWriteW cannot store other types, so there is nothing to find */
+        TRACE("no credentials of type %ld for target name %s\n", Type, debugstr_w(TargetName));
+        SetLastError(ERROR_NOT_FOUND);
+        return FALSE;
+    }
+
     if (Type == CRED_TYPE_DOMAIN_PASSWORD)
     {
         ret = host_read_credential( TargetName, Credential );
diff --git a/dlls/advapi32/tests/cred.c b/dlls/advapi32/tests/cred.c
index f1fafd3..6bd5f15 100644
--- a/dlls/advapi32/tests/cred.c
+++ b/dlls/advapi32/tests/cred.c
@@ -65,6 +65,17 @@ static void test_CredReadA(void)
     ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER,
         "CredReadA should have failed with ERROR_INVALID_PARAMETER instead of %ld\n",
         GetLastError());
+
+    /* valid but absent types report ERROR_NOT_FOUND (the Remote Desktop client relies on this) */
+    SetLastError(0xdeadbeef);
+    ret = CredReadW(L"TERMSRV/wine-test.invalid", CRED_TYPE_DOMAIN_EXTENDED, 0, (PCREDENTIALW *)&cred);
+    ok(!ret && GetLastError() == ERROR_NOT_FOUND,
+        "CredReadW should have failed with ERROR_NOT_FOUND instead of %ld\n", GetLastError());
+
+    SetLastError(0xdeadbeef);
+    ret = CredReadW(L"TERMSRV/wine-test.invalid", CRED_TYPE_DOMAIN_PASSWORD, 0, (PCREDENTIALW *)&cred);
+    ok(!ret && GetLastError() == ERROR_NOT_FOUND,
+        "CredReadW should have failed with ERROR_NOT_FOUND instead of %ld\n", GetLastError());
 }
 
 static void test_CredWriteA(void)
diff --git a/include/wincred.h b/include/wincred.h
index ad4c06f..348d0d0 100644
--- a/include/wincred.h
+++ b/include/wincred.h
@@ -216,6 +216,7 @@ typedef struct _BINARY_BLOB_CREDENTIAL_INFO
 #define CRED_TYPE_DOMAIN_CERTIFICATE                3
 #define CRED_TYPE_DOMAIN_VISIBLE_PASSWORD           4
 #define CRED_TYPE_GENERIC_CERTIFICATE               5
+#define CRED_TYPE_DOMAIN_EXTENDED                   6
 #define CRED_TYPE_MAXIMUM                           6
 #define CRED_TYPE_MAXIMUM_EX                        (CRED_TYPE_MAXIMUM+1000)
 
