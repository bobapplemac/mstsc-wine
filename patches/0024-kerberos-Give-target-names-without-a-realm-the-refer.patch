From 8bfc2394d4c4a810ff586dbec2957476c498db25 Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sun, 15 Nov 2026 14:08:49 -0500
Subject: [PATCH 24/43] kerberos: Give target names without a realm the
 referral realm.

Windows asks the user's own KDC for a service name such as "TERMSRV/host" and follows its
referrals. Import such names with the empty realm instead of relying on a default realm,
which machines outside the domain usually do not have configured.
---
 dlls/kerberos/unixlib.c | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/dlls/kerberos/unixlib.c b/dlls/kerberos/unixlib.c
index 08a6378..d75c044 100644
--- a/dlls/kerberos/unixlib.c
+++ b/dlls/kerberos/unixlib.c
@@ -647,6 +647,29 @@ static NTSTATUS import_name( const char *src, gss_name_t *dst )
     return status_gss_to_sspi( ret );
 }
 
+/* A target SPN ("TERMSRV/host") has no realm. Windows asks the user's own KDC and follows
+ * its referrals; give the name the empty (referral) realm to do the same, instead of the
+ * default realm, which a machine outside the domain usually does not have configured. */
+static NTSTATUS import_target_name( const char *src, gss_name_t *dst )
+{
+    static gss_OID_desc nt_krb5_principal = { 10, (void *)"\x2a\x86\x48\x86\xf7\x12\x01\x02\x02\x01" };
+    OM_uint32 ret, minor_status;
+    gss_buffer_desc buf;
+    char *name;
+
+    if (strchr( src, '@' ) || !strchr( src, '/' )) return import_name( src, dst );
+    if (!(name = malloc( strlen( src ) + 2 ))) return STATUS_NO_MEMORY;
+    strcpy( name, src );
+    strcat( name, "@" );
+    buf.length = strlen( name );
+    buf.value  = name;
+    ret = pgss_import_name( &minor_status, &buf, &nt_krb5_principal, dst );
+    TRACE( "gss_import_name %s returned %#x minor status %#x\n", debugstr_a(name), ret, minor_status );
+    if (GSS_ERROR( ret )) trace_gss_status( ret, minor_status );
+    free( name );
+    return status_gss_to_sspi( ret );
+}
+
 static NTSTATUS acquire_credentials_handle( void *args )
 {
     struct acquire_credentials_handle_params *params = args;
@@ -757,7 +780,7 @@ static NTSTATUS initialize_context( void *args )
     output_token.length = 0;
     output_token.value  = NULL;
 
-    if (params->target_name && (status = import_name( params->target_name, &target ))) return status;
+    if (params->target_name && (status = import_target_name( params->target_name, &target ))) return status;
 
     if (req_flags & GSS_C_CONF_FLAG) req_flags |= GSS_C_INTEG_FLAG;
 
