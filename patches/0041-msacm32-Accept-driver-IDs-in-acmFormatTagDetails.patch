From 46db263b30c0cb83206f28391ec041fd4b7b95da Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Wed, 18 Nov 2026 22:42:58 -0500
Subject: [PATCH 41/43] msacm32: Accept driver IDs in acmFormatTagDetails.

---
 dlls/msacm32/format.c      | 14 ++++++++++++++
 dlls/msacm32/tests/msacm.c | 37 +++++++++++++++++++++++++++++++++++++
 2 files changed, 51 insertions(+)

diff --git a/dlls/msacm32/format.c b/dlls/msacm32/format.c
index 6aab538..0f8f6b9 100644
--- a/dlls/msacm32/format.c
+++ b/dlls/msacm32/format.c
@@ -848,6 +848,7 @@ MMRESULT WINAPI acmFormatTagDetailsW(HACMDRIVER had, PACMFORMATTAGDETAILSW paftd
 				     DWORD fdwDetails)
 {
     PWINE_ACMDRIVERID	padid;
+    HACMDRIVER opened = NULL;
     MMRESULT		mmr = ACMERR_NOTPOSSIBLE;
 
     TRACE("(%p, %p, %ld)\n", had, paftd, fdwDetails);
@@ -856,6 +857,16 @@ MMRESULT WINAPI acmFormatTagDetailsW(HACMDRIVER had, PACMFORMATTAGDETAILSW paftd
 		       ACM_FORMATTAGDETAILSF_LARGESTSIZE))
 	return MMSYSERR_INVALFLAG;
 
+    /* Native accepts a driver ID here as well as the documented open driver
+     * handle.  Modern mstsc relies on this while enumerating playback codecs. */
+    if (had && MSACM_GetDriverID((HACMDRIVERID)had))
+    {
+        mmr = acmDriverOpen(&opened, (HACMDRIVERID)had, 0);
+        if (mmr != MMSYSERR_NOERROR)
+            return mmr;
+        had = opened;
+    }
+
     switch (fdwDetails) {
     case ACM_FORMATTAGDETAILSF_FORMATTAG:
 	if (had == NULL) {
@@ -926,6 +937,9 @@ MMRESULT WINAPI acmFormatTagDetailsW(HACMDRIVER had, PACMFORMATTAGDETAILSW paftd
         MultiByteToWideChar(CP_ACP, 0, "PCM", -1, paftd->szFormatTag,
                             ARRAY_SIZE(paftd->szFormatTag));
 
+    if (opened)
+        acmDriverClose(opened, 0);
+
     return mmr;
 }
 
diff --git a/dlls/msacm32/tests/msacm.c b/dlls/msacm32/tests/msacm.c
index 5980ac7..0c0df7a 100644
--- a/dlls/msacm32/tests/msacm.c
+++ b/dlls/msacm32/tests/msacm.c
@@ -1250,6 +1250,42 @@ static void test_acmFormatTagDetails(void)
         ok(aftd.cbFormatSize == sizeof(MPEGLAYER3WAVEFORMAT), "got %ld\n", aftd.cbFormatSize);
 }
 
+struct driver_id_format_tag_state
+{
+    unsigned int drivers;
+    unsigned int pcm_drivers;
+};
+
+static BOOL CALLBACK driver_id_format_tag_cb(HACMDRIVERID hadid, DWORD_PTR instance,
+        DWORD support)
+{
+    struct driver_id_format_tag_state *state = (void *)instance;
+    ACMFORMATTAGDETAILSW aftd = {0};
+    MMRESULT rc;
+
+    state->drivers++;
+    aftd.cbStruct = sizeof(aftd);
+    aftd.dwFormatTag = WAVE_FORMAT_PCM;
+    rc = acmFormatTagDetailsW((HACMDRIVER)hadid, &aftd, ACM_FORMATTAGDETAILSF_FORMATTAG);
+    if (rc == MMSYSERR_NOERROR)
+    {
+        ok(aftd.dwFormatTag == WAVE_FORMAT_PCM, "expected PCM, got %#lx\n", aftd.dwFormatTag);
+        state->pcm_drivers++;
+    }
+    return TRUE;
+}
+
+static void test_driver_id_format_tag_details(void)
+{
+    struct driver_id_format_tag_state state = {0};
+    MMRESULT rc;
+
+    rc = acmDriverEnum(driver_id_format_tag_cb, (DWORD_PTR)&state, 0);
+    ok(rc == MMSYSERR_NOERROR, "acmDriverEnum failed with %#x\n", rc);
+    ok(state.drivers != 0, "expected at least one ACM driver\n");
+    ok(state.pcm_drivers != 0, "no driver ID accepted by acmFormatTagDetailsW\n");
+}
+
 static void test_acmFormatChoose(void)
 {
     ACMFORMATCHOOSEW afc = {0};
@@ -1528,6 +1564,7 @@ START_TEST(msacm)
     test_convert();
     test_acmFormatSuggest();
     test_acmFormatTagDetails();
+    test_driver_id_format_tag_details();
     test_acmFormatChoose();
     test_mp3();
     /* Test acmDriverAdd in the end as it may conflict
-- 
