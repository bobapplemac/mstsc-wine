From ed0e99be903623e6f0bcb61f4d444784c2f86cc0 Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sat, 14 Nov 2026 14:46:06 -0500
Subject: [PATCH 16/43] winex11: Release fullscreen cursor clipping when a
 window leaves fullscreen.

Fullscreen windows get the cursor clipped to the monitor, which grabs the
X pointer. The grab was only released when the window was hidden, so a
window restored from fullscreen to a normal window (e.g. mstsc's
connection bar "Restore") kept the pointer grabbed: the window manager
never received clicks on the frame buttons and the desktop was unusable.

Only a clip rectangle covering the whole virtual screen is released,
which means no clipping to Windows applications; an application's own
ClipCursor rectangle is kept.
---
 dlls/winex11.drv/mouse.c  | 22 ++++++++++++++++++++++
 dlls/winex11.drv/window.c |  8 +++++++-
 dlls/winex11.drv/x11drv.h |  1 +
 3 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/dlls/winex11.drv/mouse.c b/dlls/winex11.drv/mouse.c
index 1ddd302..a1643c7 100644
--- a/dlls/winex11.drv/mouse.c
+++ b/dlls/winex11.drv/mouse.c
@@ -457,6 +457,28 @@ void ungrab_clipping_window(void)
     x11drv_xinput2_disable( data->display, DefaultRootWindow( data->display ) );
 }
 
+/***********************************************************************
+ *      is_fullscreen_clipping
+ *
+ * Check whether the pointer is grabbed for a clip rectangle that covers the whole
+ * virtual screen, as set for fullscreen windows. Such a rectangle means no clipping
+ * to Windows applications, so it can be released without changing their behaviour.
+ */
+BOOL is_fullscreen_clipping(void)
+{
+    RECT rect, virtual;
+    UINT context;
+    BOOL ret;
+
+    if (!clipping_cursor) return FALSE;
+    context = NtUserSetThreadDpiAwarenessContext( NTUSER_DPI_PER_MONITOR_AWARE );
+    virtual = NtUserGetVirtualScreenRect( MDT_RAW_DPI );
+    ret = NtUserGetClipCursor( &rect ) && rect.left <= virtual.left && rect.top <= virtual.top &&
+          rect.right >= virtual.right && rect.bottom >= virtual.bottom;
+    NtUserSetThreadDpiAwarenessContext( context );
+    return ret;
+}
+
 /***********************************************************************
  *      reapply_cursor_clipping
  */
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 7ff9b88..d8d5bf6 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -3322,7 +3322,13 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     }
 
     /* if window was fullscreen and is being hidden, release cursor clipping */
-    was_fullscreen &= data->desired_state.wm_state != NormalState;
+    if (was_fullscreen && data->desired_state.wm_state == NormalState)
+    {
+        /* if it stays visible but is no longer fullscreen (e.g. restored to a normal window),
+         * release the fullscreen clipping too; otherwise the pointer grab keeps the window
+         * manager from receiving any input, including the window's own frame buttons */
+        was_fullscreen = !fullscreen && is_fullscreen_clipping();
+    }
 
     XFlush( data->display );  /* make sure changes are done before we start painting again */
     release_win_data( data );
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 9232988..8d86546 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -749,6 +749,7 @@ extern XContext cursor_context;
 
 extern BOOL is_current_process_focused(void);
 extern void X11DRV_ActivateWindow( HWND hwnd, HWND previous );
+extern BOOL is_fullscreen_clipping(void);
 extern void reapply_cursor_clipping(void);
 extern void ungrab_clipping_window(void);
 extern void move_resize_window( HWND hwnd, int dir, POINT pos );
