From 91f1333b2a3e202ae095f17870e1f8390f112cbf Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Thu, 19 Nov 2026 00:18:01 -0500
Subject: [PATCH 42/43] ntdll: Add opt-in classic WPP diagnostics

---
 dlls/ntdll/misc.c | 53 ++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 52 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/misc.c b/dlls/ntdll/misc.c
index 81ac7b3..6f2ddd3 100644
--- a/dlls/ntdll/misc.c
+++ b/dlls/ntdll/misc.c
@@ -30,6 +30,7 @@
 #include "evntprov.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(ntdll);
+WINE_DECLARE_DEBUG_CHANNEL(wpp);
 
 LPCSTR debugstr_us( const UNICODE_STRING *us )
 {
@@ -380,10 +381,15 @@ ULONG WINAPI EtwRegisterTraceGuidsW( WMIDPREQUEST RequestAddress,
                 TRACE_GUID_REGISTRATION *TraceGuidReg, const WCHAR *MofImagePath,
                 const WCHAR *MofResourceName, TRACEHANDLE *RegistrationHandle )
 {
+    WNODE_HEADER header = {0};
+    ULONG size = sizeof(header);
+
     WARN("(%p, %p, %s, %lu, %p, %s, %s, %p): stub\n", RequestAddress, RequestContext,
           debugstr_guid(ControlGuid), GuidCount, TraceGuidReg, debugstr_w(MofImagePath),
           debugstr_w(MofResourceName), RegistrationHandle);
 
+    if (!RegistrationHandle) return ERROR_INVALID_PARAMETER;
+
     if (TraceGuidReg)
     {
         ULONG i;
@@ -394,6 +400,16 @@ ULONG WINAPI EtwRegisterTraceGuidsW( WMIDPREQUEST RequestAddress,
         }
     }
     *RegistrationHandle = (TRACEHANDLE)0xdeadbeef;
+
+    if (TRACE_ON(wpp) && RequestAddress)
+    {
+        header.BufferSize = sizeof(header);
+        header.HistoricalContext = *RegistrationHandle;
+        if (ControlGuid) header.Guid = *ControlGuid;
+        TRACE_(wpp)("enabling classic provider %s context %p\n",
+                    debugstr_guid(ControlGuid), RequestContext);
+        RequestAddress(WMI_ENABLE_EVENTS, RequestContext, &size, &header);
+    }
     return ERROR_SUCCESS;
 }
 
@@ -405,9 +421,24 @@ ULONG WINAPI EtwRegisterTraceGuidsA( WMIDPREQUEST RequestAddress,
                 TRACE_GUID_REGISTRATION *TraceGuidReg, const char *MofImagePath,
                 const char *MofResourceName, TRACEHANDLE *RegistrationHandle )
 {
+    WNODE_HEADER header = {0};
+    ULONG size = sizeof(header);
+
     WARN("(%p, %p, %s, %lu, %p, %s, %s, %p): stub\n", RequestAddress, RequestContext,
           debugstr_guid(ControlGuid), GuidCount, TraceGuidReg, debugstr_a(MofImagePath),
           debugstr_a(MofResourceName), RegistrationHandle);
+    if (!RegistrationHandle) return ERROR_INVALID_PARAMETER;
+
+    *RegistrationHandle = (TRACEHANDLE)0xdeadbeef;
+    if (TRACE_ON(wpp) && RequestAddress)
+    {
+        header.BufferSize = sizeof(header);
+        header.HistoricalContext = *RegistrationHandle;
+        if (ControlGuid) header.Guid = *ControlGuid;
+        TRACE_(wpp)("enabling classic provider %s context %p\n",
+                    debugstr_guid(ControlGuid), RequestContext);
+        RequestAddress(WMI_ENABLE_EVENTS, RequestContext, &size, &header);
+    }
     return ERROR_SUCCESS;
 }
 
@@ -460,7 +491,7 @@ ULONG WINAPI EtwEventWriteEx( REGHANDLE handle, const EVENT_DESCRIPTOR *descript
 ULONG WINAPI EtwGetTraceEnableFlags( TRACEHANDLE handle )
 {
     FIXME("(%s) stub\n", wine_dbgstr_longlong(handle));
-    return 0;
+    return TRACE_ON(wpp) ? ~0u : 0;
 }
 
 /******************************************************************************
@@ -478,6 +509,7 @@ UCHAR WINAPI EtwGetTraceEnableLevel( TRACEHANDLE handle )
 TRACEHANDLE WINAPI EtwGetTraceLoggerHandle( PVOID buf )
 {
     FIXME("(%p) stub\n", buf);
+    if (TRACE_ON(wpp) && buf) return ((WNODE_HEADER *)buf)->HistoricalContext;
     return INVALID_PROCESSTRACE_HANDLE;
 }
 
@@ -496,6 +528,25 @@ ULONG WINAPI EtwLogTraceEvent( TRACEHANDLE SessionHandle, PEVENT_TRACE_HEADER Ev
 ULONG WINAPI EtwTraceMessageVa( TRACEHANDLE handle, ULONG flags, LPGUID guid, USHORT number,
                                 va_list args )
 {
+    unsigned int i;
+
+    if (TRACE_ON(wpp))
+    {
+        TRACE_(wpp)("handle %s flags %#lx provider %s event %u caller %p\n",
+                    wine_dbgstr_longlong(handle), flags, debugstr_guid(guid), number,
+                    __builtin_return_address(0));
+        for (i = 0; i < 16; i++)
+        {
+            const void *data = va_arg(args, const void *);
+            SIZE_T size;
+
+            if (!data) break;
+            size = va_arg(args, SIZE_T);
+            TRACE_(wpp)("  arg %u size %Iu data %s\n", i, size,
+                        wine_dbgstr_an(data, min(size, 64)));
+        }
+        return ERROR_SUCCESS;
+    }
     FIXME("(%s %lx %s %d) : stub\n", wine_dbgstr_longlong(handle), flags, debugstr_guid(guid), number);
     return ERROR_SUCCESS;
 }
-- 
