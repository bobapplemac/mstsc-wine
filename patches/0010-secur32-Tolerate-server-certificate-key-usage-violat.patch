From ac7fcf7916b26ce201826531023639af4d2a5d9a Mon Sep 17 00:00:00 2001
From: "Andrew J. Moore" <andrew@forevermoore.net>
Date: Sat, 14 Nov 2026 10:45:21 -0500
Subject: [PATCH 10/43] secur32: Tolerate server certificate key usage
 violations in client sessions.

Windows clients accept server certificates whose key usage lacks
digitalSignature when the key signs the key exchange; default Remote
Desktop server certificates rely on this with ECDHE_RSA.  Request
%DEBUG_ALLOW_KEY_USAGE_VIOLATIONS for client sessions, falling back to
the previous priority string if GnuTLS rejects it.  Certificate trust
validation is unaffected; it is still done by the application.

Stock GnuTLS 3.8 applies this keyword to local certificates only; the
mstsc-wine runtime ships a GnuTLS that also applies it to the peer.
---
 dlls/secur32/schannel_gnutls.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/dlls/secur32/schannel_gnutls.c b/dlls/secur32/schannel_gnutls.c
index 947c591..1c4af7d 100644
--- a/dlls/secur32/schannel_gnutls.c
+++ b/dlls/secur32/schannel_gnutls.c
@@ -434,7 +434,7 @@ static int pull_timeout(gnutls_transport_ptr_t transport, unsigned int timeout)
 
 static NTSTATUS set_priority(schan_credentials *cred, gnutls_session_t session)
 {
-    char priority[128] = "NORMAL:%LATEST_RECORD_VERSION", *p;
+    char priority[192] = "NORMAL:%LATEST_RECORD_VERSION", *p;
     BOOL server = !!(cred->credential_use & SECPKG_CRED_INBOUND);
     const struct protocol_priority_flag *protocols =
         server ? server_protocol_priority_flags : client_protocol_priority_flags;
@@ -480,6 +480,21 @@ static NTSTATUS set_priority(schan_credentials *cred, gnutls_session_t session)
         p += strlen(p);
     }
 
+    /* Windows clients do not enforce the key usage extension of the server
+     * certificate during the handshake; e.g. the default self-signed certificates
+     * of Remote Desktop servers lack digitalSignature but are used with ECDHE_RSA.
+     * Certificate trust is still verified by the application.  Stock GnuTLS
+     * applies this keyword to local certificates only; GnuTLS builds that also
+     * apply it to the peer certificate are needed for the client behaviour. */
+    if (!server)
+    {
+        strcpy(p, ":%DEBUG_ALLOW_KEY_USAGE_VIOLATIONS");
+        TRACE("Using %s priority\n", debugstr_a(priority));
+        if (pgnutls_priority_set_direct(session, priority, NULL) == GNUTLS_E_SUCCESS) return STATUS_SUCCESS;
+        WARN("GnuTLS does not support %%DEBUG_ALLOW_KEY_USAGE_VIOLATIONS\n");
+        *p = 0;
+    }
+
     TRACE("Using %s priority\n", debugstr_a(priority));
     err = pgnutls_priority_set_direct(session, priority, NULL);
     if (err != GNUTLS_E_SUCCESS)
-- 
2.47.3

