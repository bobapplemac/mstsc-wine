From 14ff23154bd923b4a959b58e53ab01c001a538bd Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sat, 14 Nov 2026 23:25:24 -0500
Subject: [PATCH 20/43] credui: Wrap long messages in the credential dialog.

The message line is one line high, so longer messages were cut off after the first
line. Grow it to fit the wrapped text and move the controls below it down.
---
 dlls/credui/Makefile.in   |  2 +-
 dlls/credui/credui_main.c | 60 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/dlls/credui/Makefile.in b/dlls/credui/Makefile.in
index 0dbbf17..b1f98a0 100644
--- a/dlls/credui/Makefile.in
+++ b/dlls/credui/Makefile.in
@@ -1,7 +1,7 @@
 EXTRADEFS = -D_CREDUI_
 MODULE    = credui.dll
 IMPORTLIB = credui
-IMPORTS   = comctl32 user32 advapi32 ole32
+IMPORTS   = comctl32 user32 gdi32 advapi32 ole32
 
 EXTRADLLFLAGS = -Wb,--prefer-native
 
diff --git a/dlls/credui/credui_main.c b/dlls/credui/credui_main.c
index bb8c47b..ec3c137 100644
--- a/dlls/credui/credui_main.c
+++ b/dlls/credui/credui_main.c
@@ -372,6 +372,65 @@ static LRESULT CALLBACK CredDialogPasswordSubclassProc(HWND hwnd, UINT uMsg,
     return DefSubclassProc(hwnd, uMsg, wParam, lParam);
 }
 
+struct move_down
+{
+    HWND dialog;
+    LONG below;     /* move the controls that start at or below this line */
+    LONG offset;
+};
+
+static BOOL CALLBACK CredDialogMoveDown(HWND hwnd, LPARAM lparam)
+{
+    const struct move_down *move = (const struct move_down *)lparam;
+    RECT rc;
+
+    if (GetParent(hwnd) != move->dialog) return TRUE;   /* only the dialog's own controls */
+    GetWindowRect(hwnd, &rc);
+    MapWindowPoints(NULL, move->dialog, (POINT *)&rc, 2);
+    if (rc.top >= move->below)
+        SetWindowPos(hwnd, NULL, rc.left, rc.top + move->offset, 0, 0,
+                     SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+    return TRUE;
+}
+
+/* The message control is one line high; wrap a longer message and make room for it by
+ * moving the controls below it down and growing the dialog. */
+static void CredDialogFitMessage(HWND hwndDlg)
+{
+    HWND hwndMessage = GetDlgItem(hwndDlg, IDC_MESSAGE);
+    struct move_down move;
+    RECT rc, need;
+    WCHAR *text;
+    HFONT old;
+    int len, grow;
+    HDC hdc;
+
+    if (!(len = GetWindowTextLengthW(hwndMessage))) return;
+    if (!(text = malloc((len + 1) * sizeof(WCHAR)))) return;
+    GetWindowTextW(hwndMessage, text, len + 1);
+    GetClientRect(hwndMessage, &rc);
+    need = rc;
+    hdc = GetDC(hwndMessage);
+    old = SelectObject(hdc, (HFONT)SendMessageW(hwndMessage, WM_GETFONT, 0, 0));
+    DrawTextW(hdc, text, -1, &need, DT_CALCRECT | DT_WORDBREAK | DT_EXPANDTABS);
+    SelectObject(hdc, old);
+    ReleaseDC(hwndMessage, hdc);
+    free(text);
+    if ((grow = need.bottom - rc.bottom) <= 0) return;
+
+    GetWindowRect(hwndMessage, &rc);
+    MapWindowPoints(NULL, hwndDlg, (POINT *)&rc, 2);
+    move.dialog = hwndDlg;
+    move.below = rc.bottom;
+    move.offset = grow;
+    EnumChildWindows(hwndDlg, CredDialogMoveDown, (LPARAM)&move);
+    SetWindowPos(hwndMessage, NULL, 0, 0, rc.right - rc.left, rc.bottom - rc.top + grow,
+                 SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+    GetWindowRect(hwndDlg, &rc);
+    SetWindowPos(hwndDlg, NULL, 0, 0, rc.right - rc.left, rc.bottom - rc.top + grow,
+                 SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
 static BOOL CredDialogInit(HWND hwndDlg, struct cred_dialog_params *params)
 {
     HWND hwndUsername = GetDlgItem(hwndDlg, IDC_USERNAME);
@@ -393,6 +452,7 @@ static BOOL CredDialogInit(HWND hwndDlg, struct cred_dialog_params *params)
         swprintf(message, ARRAY_SIZE(message), format, params->pszTargetName);
         SetDlgItemTextW(hwndDlg, IDC_MESSAGE, message);
     }
+    CredDialogFitMessage(hwndDlg);
     SetWindowTextW(hwndUsername, params->pszUsername);
     SetWindowTextW(hwndPassword, params->pszPassword);
 
-- 
