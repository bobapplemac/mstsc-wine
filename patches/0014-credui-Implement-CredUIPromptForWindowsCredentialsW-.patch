-/******************************************************************************
- * CredUIPromptForWindowsCredentialsW [CREDUI.@]
- */
-DWORD WINAPI CredUIPromptForWindowsCredentialsW( CREDUI_INFOW *info, DWORD error, ULONG *package,
-                                                 const void *in_buf, ULONG in_buf_size, void **out_buf,
-                                                 ULONG *out_buf_size, BOOL *save, DWORD flags )
+/* Packed credentials use the KERB_INTERACTIVE_UNLOCK_LOGON layout, with string
+ * buffers stored as offsets from the start of the packed buffer. */
+static BOOL get_packed_string( const BYTE *buf, DWORD size, const UNICODE_STRING *str,
+                               const WCHAR **ptr, DWORD *len )
 {
-    FIXME( "(%p, %lu, %p, %p, %lu, %p, %p, %p, %08lx) stub\n", info, error, package, in_buf, in_buf_size,
-           out_buf, out_buf_size, save, flags );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    ULONG_PTR off = (ULONG_PTR)str->Buffer;
+
+    *ptr = NULL;
+    *len = str->Length / sizeof(WCHAR);
+    if (!str->Length) return TRUE;
+    if (str->Length & 1) return FALSE;
+    if (off >= (ULONG_PTR)buf && off - (ULONG_PTR)buf < size) off -= (ULONG_PTR)buf; /* absolute pointer */
+    if (off > size || str->Length > size - off) return FALSE;
+    *ptr = (const WCHAR *)(buf + off);
+    return TRUE;
 }
 
 /******************************************************************************
  * CredPackAuthenticationBufferW [CREDUI.@]
  */
-BOOL  WINAPI CredPackAuthenticationBufferW( DWORD flags, WCHAR *username, WCHAR *password, BYTE *buf,
-                                            DWORD *size )
+BOOL WINAPI CredPackAuthenticationBufferW( DWORD flags, WCHAR *username, WCHAR *password, BYTE *buf,
+                                           DWORD *size )
 {
-    FIXME( "(%08lx, %s, %p, %p, %p) stub\n", flags, debugstr_w(username), password, buf, size );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    KERB_INTERACTIVE_UNLOCK_LOGON *logon;
+    const WCHAR *user = username, *sep;
+    DWORD len_domain = 0, len_user, len_password, needed;
+    BYTE *ptr;
+
+    TRACE( "(%08lx, %s, %p, %p, %p)\n", flags, debugstr_w(username), password, buf, size );
+
+    if (!username || !password || !size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (flags & ~CRED_PACK_GENERIC_CREDENTIALS) FIXME( "unsupported flags %#lx\n", flags );
+
+    if (!(flags & CRED_PACK_GENERIC_CREDENTIALS) && (sep = wcschr( username, '\\' )))
+    {
+        len_domain = sep - username;
+        user = sep + 1;
+    }
+    len_user = lstrlenW( user );
+    len_password = lstrlenW( password );
+    if (len_domain > 0x7fff || len_user > 0x7fff || len_password > 0x7fff)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    needed = sizeof(*logon) + (len_domain + len_user + len_password) * sizeof(WCHAR);
+    if (!buf || *size < needed)
+    {
+        *size = needed;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+
+    logon = (KERB_INTERACTIVE_UNLOCK_LOGON *)buf;
+    memset( logon, 0, sizeof(*logon) );
+    logon->Logon.MessageType = KerbInteractiveLogon;
+    ptr = buf + sizeof(*logon);
+#define PACK(field, src, len) \
+    logon->Logon.field.Length = logon->Logon.field.MaximumLength = (len) * sizeof(WCHAR); \
+    logon->Logon.field.Buffer = (len) ? (WCHAR *)(ULONG_PTR)(ptr - buf) : NULL; \
+    memcpy( ptr, (src), (len) * sizeof(WCHAR) ); ptr += (len) * sizeof(WCHAR);
+    PACK( LogonDomainName, username, len_domain );
+    PACK( UserName, user, len_user );
+    PACK( Password, password, len_password );
+#undef PACK
+    *size = needed;
+    return TRUE;
 }
 
 /******************************************************************************
  * CredUnPackAuthenticationBufferW [CREDUI.@]
  */
-BOOL  WINAPI CredUnPackAuthenticationBufferW( DWORD flags, void *buf, DWORD size, WCHAR *username,
-                                              DWORD *len_username, WCHAR *domain, DWORD *len_domain,
-                                              WCHAR *password, DWORD *len_password )
+BOOL WINAPI CredUnPackAuthenticationBufferW( DWORD flags, void *buf, DWORD size, WCHAR *username,
+                                             DWORD *len_username, WCHAR *domain, DWORD *len_domain,
+                                             WCHAR *password, DWORD *len_password )
 {
-    FIXME( "(%08lx, %p, %lu, %p, %p, %p, %p, %p, %p) stub\n", flags, buf, size, username, len_username,
+    const KERB_INTERACTIVE_UNLOCK_LOGON *logon = buf;
+    const WCHAR *user_str, *domain_str, *password_str;
+    DWORD user_len, domain_len, password_len, need_user, need_domain, need_password;
+    BOOL split;
+
+    TRACE( "(%08lx, %p, %lu, %p, %p, %p, %p, %p, %p)\n", flags, buf, size, username, len_username,
            domain, len_domain, password, len_password );
-    return ERROR_CALL_NOT_IMPLEMENTED;
+
+    if (!buf || size < sizeof(*logon) || !len_username || !len_password)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (logon->Logon.MessageType != KerbInteractiveLogon &&
+        logon->Logon.MessageType != KerbWorkstationUnlockLogon)
+    {
+        FIXME( "unsupported logon type %u\n", logon->Logon.MessageType );
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+    if (!get_packed_string( buf, size, &logon->Logon.UserName, &user_str, &user_len ) ||
+        !get_packed_string( buf, size, &logon->Logon.LogonDomainName, &domain_str, &domain_len ) ||
+        !get_packed_string( buf, size, &logon->Logon.Password, &password_str, &password_len ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    /* without a domain buffer, the domain is returned as part of the user name */
+    split = domain && len_domain;
+    need_user = user_len + 1 + ((!split && domain_len) ? domain_len + 1 : 0);
+    need_domain = domain_len + 1;
+    if (flags & CRED_PACK_PROTECTED_CREDENTIALS)
+    {
+        CRED_PROTECTION_TYPE type;
+        WCHAR *tmp = malloc( (password_len + 1) * sizeof(WCHAR) );
+        DWORD len = 0;
+
+        if (!tmp) { SetLastError( ERROR_OUTOFMEMORY ); return FALSE; }
+        memcpy( tmp, password_str, password_len * sizeof(WCHAR) );
+        tmp[password_len] = 0;
+        if (CredIsProtectedW( tmp, &type ) && type != CredUnprotected) need_password = password_len + 1;
+        else CredProtectW( TRUE, tmp, password_len + 1, NULL, &len, NULL ), need_password = len;
+        SecureZeroMemory( tmp, password_len * sizeof(WCHAR) );
+        free( tmp );
+    }
+    else need_password = password_len + 1;
+
+    if (!username || *len_username < need_user || (split && *len_domain < need_domain) ||
+        !password || *len_password < need_password)
+    {
+        *len_username = need_user;
+        if (split) *len_domain = need_domain;
+        else if (len_domain) *len_domain = 0;
+        *len_password = need_password;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+
+    if (!split && domain_len)
+    {
+        memcpy( username, domain_str, domain_len * sizeof(WCHAR) );
+        username[domain_len] = '\\';
+        memcpy( username + domain_len + 1, user_str, user_len * sizeof(WCHAR) );
+    }
+    else memcpy( username, user_str, user_len * sizeof(WCHAR) );
+    username[need_user - 1] = 0;
+    *len_username = need_user;
+    if (split)
+    {
+        memcpy( domain, domain_str, domain_len * sizeof(WCHAR) );
+        domain[domain_len] = 0;
+        *len_domain = need_domain;
+    }
+    else if (len_domain) *len_domain = 0;
+
+    memcpy( password, password_str, password_len * sizeof(WCHAR) );
+    password[password_len] = 0;
+    if ((flags & CRED_PACK_PROTECTED_CREDENTIALS) && need_password != password_len + 1)
+    {
+        WCHAR *tmp = malloc( (password_len + 1) * sizeof(WCHAR) );
+        DWORD len = *len_password;
+
+        if (!tmp) { SetLastError( ERROR_OUTOFMEMORY ); return FALSE; }
+        memcpy( tmp, password, (password_len + 1) * sizeof(WCHAR) );
+        CredProtectW( TRUE, tmp, password_len + 1, password, &len, NULL );
+        SecureZeroMemory( tmp, password_len * sizeof(WCHAR) );
+        free( tmp );
+        need_password = len;
+    }
+    *len_password = need_password;
+    return TRUE;
+}
+
+/******************************************************************************
+ * CredUIPromptForWindowsCredentialsW [CREDUI.@]
+ */
+DWORD WINAPI CredUIPromptForWindowsCredentialsW( CREDUI_INFOW *info, DWORD error, ULONG *package,
+                                                 const void *in_buf, ULONG in_buf_size, void **out_buf,
+                                                 ULONG *out_buf_size, BOOL *save, DWORD flags )
+{
+    WCHAR username[CREDUI_MAX_USERNAME_LENGTH + 1] = {0};
+    WCHAR password[CREDUI_MAX_PASSWORD_LENGTH + 1] = {0};
+    WCHAR target[CREDUI_MAX_USERNAME_LENGTH + 1] = L"";
+    DWORD len_username = ARRAY_SIZE(username), len_password = ARRAY_SIZE(password);
+    DWORD ui_flags, ret, size = 0;
+    BOOL fsave = save ? *save : FALSE;
+    BYTE *packed;
+
+    TRACE( "(%p, %lu, %p, %p, %lu, %p, %p, %p, %08lx)\n", info, error, package, in_buf, in_buf_size,
+           out_buf, out_buf_size, save, flags );
+
+    if (!out_buf || !out_buf_size || !package) return ERROR_INVALID_PARAMETER;
+    if ((flags & CREDUIWIN_CHECKBOX) && !save) return ERROR_INVALID_PARAMETER;
+    if (flags & ~(CREDUIWIN_GENERIC | CREDUIWIN_CHECKBOX | CREDUIWIN_AUTHPACKAGE_ONLY | CREDUIWIN_IN_CRED_ONLY |
+                  CREDUIWIN_ENUMERATE_CURRENT_USER | CREDUIWIN_IGNORE_CLOUDAUTHORITY_NAME |
+                  CREDUIWIN_DOWNLEVEL_HELLO_AS_SMART_CARD))
+        FIXME( "unsupported flags %#lx\n", flags );
+
+    *out_buf = NULL;
+    *out_buf_size = 0;
+    if (in_buf && in_buf_size)
+    {
+        DWORD len_domain = 0;
+        if (!CredUnPackAuthenticationBufferW( 0, (void *)in_buf, in_buf_size, username, &len_username,
+                                              NULL, &len_domain, password, &len_password ))
+            WARN( "could not unpack input credentials, error %lu\n", GetLastError() );
+    }
+
+    /* The dialog asks for a user name and password; the caller decides whether to store
+     * them (the save check box only reports the user's choice). */
+    ui_flags = CREDUI_FLAGS_ALWAYS_SHOW_UI | CREDUI_FLAGS_GENERIC_CREDENTIALS | CREDUI_FLAGS_DO_NOT_PERSIST;
+    if (flags & CREDUIWIN_CHECKBOX) ui_flags |= CREDUI_FLAGS_SHOW_SAVE_CHECK_BOX;
+    if (error) ui_flags |= CREDUI_FLAGS_INCORRECT_PASSWORD;
+    if (info && info->pszCaptionText) lstrcpynW( target, info->pszCaptionText, ARRAY_SIZE(target) );
+
+    ret = CredUIPromptForCredentialsW( info, target, NULL, error, username, ARRAY_SIZE(username),
+                                       password, ARRAY_SIZE(password), &fsave, ui_flags );
+    if (!ret)
+    {
+        if (!CredPackAuthenticationBufferW( 0, username, password, NULL, &size ) &&
+            GetLastError() == ERROR_INSUFFICIENT_BUFFER && (packed = CoTaskMemAlloc( size )) &&
+            CredPackAuthenticationBufferW( 0, username, password, packed, &size ))
+        {
+            *out_buf = packed;
+            *out_buf_size = size;
+            if (save) *save = fsave;
+        }
+        else ret = ERROR_OUTOFMEMORY;
+    }
+    SecureZeroMemory( password, sizeof(password) );
+    return ret;
 }
diff --git a/dlls/credui/tests/credui.c b/dlls/credui/tests/credui.c
index 715ae35..0dfbdda 100644
--- a/dlls/credui/tests/credui.c
+++ b/dlls/credui/tests/credui.c
@@ -19,11 +19,14 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
+#include <wchar.h>
 
 #include "windef.h"
 #include "winbase.h"
 #include "wincred.h"
 #include "sspi.h"
+#include "ntsecapi.h"
 
 #include "wine/test.h"
 
@@ -188,6 +191,51 @@ static void test_SspiPromptForCredentials(void)
     }
 }
 
+static void test_CredPackAuthenticationBuffer(void)
+{
+    WCHAR user[64], domain[64], password[64];
+    DWORD size = 0, len_user, len_domain, len_password;
+    KERB_INTERACTIVE_LOGON *logon;
+    BYTE *buf;
+    BOOL ret;
+
+    SetLastError( 0xdeadbeef );
+    ret = CredPackAuthenticationBufferW( 0, (WCHAR *)L"DOM\\user", (WCHAR *)L"pass", NULL, &size );
+    ok( !ret, "expected failure\n" );
+    ok( GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError() );
+    ok( size > sizeof(*logon), "got size %lu\n", size );
+
+    buf = malloc( size );
+    ret = CredPackAuthenticationBufferW( 0, (WCHAR *)L"DOM\\user", (WCHAR *)L"pass", buf, &size );
+    ok( ret, "CredPackAuthenticationBufferW failed %lu\n", GetLastError() );
+    logon = (KERB_INTERACTIVE_LOGON *)buf;
+    ok( logon->MessageType == KerbInteractiveLogon, "got type %u\n", logon->MessageType );
+
+    /* without a domain buffer the domain is part of the user name */
+    len_user = ARRAY_SIZE(user); len_password = ARRAY_SIZE(password); len_domain = 0;
+    ret = CredUnPackAuthenticationBufferW( 0, buf, size, user, &len_user, NULL, &len_domain, password, &len_password );
+    ok( ret, "CredUnPackAuthenticationBufferW failed %lu\n", GetLastError() );
+    ok( !wcscmp( user, L"DOM\\user" ), "got %s\n", wine_dbgstr_w(user) );
+    ok( len_user == wcslen( L"DOM\\user" ) + 1, "got %lu\n", len_user );
+    ok( !wcscmp( password, L"pass" ), "got %s\n", wine_dbgstr_w(password) );
+    ok( len_password == 5, "got %lu\n", len_password );
+
+    len_user = ARRAY_SIZE(user); len_password = ARRAY_SIZE(password); len_domain = ARRAY_SIZE(domain);
+    ret = CredUnPackAuthenticationBufferW( 0, buf, size, user, &len_user, domain, &len_domain, password, &len_password );
+    ok( ret, "CredUnPackAuthenticationBufferW failed %lu\n", GetLastError() );
+    ok( (!wcscmp( user, L"user" ) && !wcscmp( domain, L"DOM" )) ||
+        (!wcscmp( user, L"DOM\\user" ) && !domain[0]), "got %s %s\n", wine_dbgstr_w(user), wine_dbgstr_w(domain) );
+
+    len_user = 2; len_password = ARRAY_SIZE(password); len_domain = 0;
+    SetLastError( 0xdeadbeef );
+    ret = CredUnPackAuthenticationBufferW( 0, buf, size, user, &len_user, NULL, &len_domain, password, &len_password );
+    ok( !ret, "expected failure\n" );
+    ok( GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError() );
+    ok( len_user == wcslen( L"DOM\\user" ) + 1, "got %lu\n", len_user );
+
+    free( buf );
+}
+
 START_TEST(credui)
 {
     HMODULE hcredui = GetModuleHandleA( "credui.dll" ), hsecur32 = LoadLibraryA( "secur32.dll" );
@@ -202,6 +250,7 @@ START_TEST(credui)
 
     test_CredUIPromptForCredentials();
     test_SspiPromptForCredentials();
+    test_CredPackAuthenticationBuffer();
 
     FreeLibrary( hsecur32 );
 }
