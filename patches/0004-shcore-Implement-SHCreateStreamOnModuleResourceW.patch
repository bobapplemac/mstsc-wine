+static void test_SHCreateStreamOnModuleResourceW(HMODULE hshcore)
+{
+    HRESULT (WINAPI *pSHCreateStreamOnModuleResourceW)(HMODULE, const WCHAR *, const WCHAR *, IStream **);
+    IStream *stream;
+    STATSTG stat;
+    DWORD size;
+    HRSRC res;
+    const void *data;
+    char buf[128];
+    HMODULE module;
+    HRESULT hr;
+    ULONG read;
+
+    pSHCreateStreamOnModuleResourceW = (void *)GetProcAddress(hshcore, MAKEINTRESOURCEA(109));
+    if (!pSHCreateStreamOnModuleResourceW)
+    {
+        win_skip("SHCreateStreamOnModuleResourceW is not available.\n");
+        return;
+    }
+
+    module = GetModuleHandleW(NULL);
+    res = FindResourceW(module, MAKEINTRESOURCEW(1), (const WCHAR *)RT_RCDATA);
+    ok(res != NULL, "no test resource\n");
+    size = SizeofResource(module, res);
+    ok(size > 0 && size <= sizeof(buf), "got resource size %lu\n", size);
+    data = LockResource(LoadResource(module, res));
+
+    stream = (IStream *)0xdeadbeef;
+    hr = pSHCreateStreamOnModuleResourceW(module, MAKEINTRESOURCEW(1), (const WCHAR *)RT_RCDATA, &stream);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(stream != NULL && stream != (IStream *)0xdeadbeef, "got %p\n", stream);
+    hr = IStream_Stat(stream, &stat, STATFLAG_NONAME);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(stat.cbSize.QuadPart == size, "got size %s, expected %lu\n", wine_dbgstr_longlong(stat.cbSize.QuadPart), size);
+    memset(buf, 0, sizeof(buf));
+    hr = IStream_Read(stream, buf, sizeof(buf), &read);
+    ok(hr == S_OK || hr == S_FALSE, "got %#lx\n", hr);
+    ok(read == size && !memcmp(buf, data, size), "got %lu bytes %s\n", read, debugstr_an(buf, read));
+    IStream_Release(stream);
+
+    stream = (IStream *)0xdeadbeef;
+    hr = pSHCreateStreamOnModuleResourceW(module, L"NoSuchResource", L"NoSuchType", &stream);
+    ok(FAILED(hr), "got %#lx\n", hr);
+    ok(stream == NULL, "got %p\n", stream);
+}
+
 START_TEST(shcore)
 {
     HMODULE hshcore = LoadLibraryA("shcore.dll");
@@ -802,4 +848,5 @@ START_TEST(shcore)
     test_SHRegGetPath();
     test_SHCopyKey();
     test_stream_size();
