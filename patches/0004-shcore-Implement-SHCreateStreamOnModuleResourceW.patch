 dlls/shcore/tests/shcore.c    | 47 +++++++++++++++++++++++++++++++++++
 dlls/shlwapi/shlwapi.spec     |  1 +
 6 files changed, 100 insertions(+), 1 deletion(-)
 create mode 100644 dlls/shcore/tests/resource.rc

diff --git a/dlls/shcore/main.c b/dlls/shcore/main.c
index 426a842..b19e092 100644
--- a/dlls/shcore/main.c
+++ b/dlls/shcore/main.c
@@ -878,6 +878,34 @@ IStream * WINAPI SHCreateMemStream(const BYTE *data, UINT data_len)
     return stream ? &stream->IStream_iface : NULL;
 }
 
+/*************************************************************************
+ * SHCreateStreamOnModuleResourceW   [SHCORE.109]
+ *
+ * Create a read-only memory IStream on a copy of a module resource.
+ */
+HRESULT WINAPI SHCreateStreamOnModuleResourceW(HMODULE module, const WCHAR *name, const WCHAR *type,
+                                               IStream **stream)
+{
+    HRSRC res;
+    HGLOBAL mem;
+    const BYTE *data;
+    DWORD size;
+
+    TRACE("(%p, %s, %s, %p)\n", module, debugstr_w(name), debugstr_w(type), stream);
+
+    if (!stream) return E_INVALIDARG;
+    *stream = NULL;
+
+    if (!(res = FindResourceW(module, name, type)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    size = SizeofResource(module, res);
+    if (!(mem = LoadResource(module, res)) || !(data = LockResource(mem)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!(*stream = SHCreateMemStream(data, size)))
+        return E_OUTOFMEMORY;
+    return S_OK;
+}
+
 static ULONG WINAPI filestream_Release(IStream *iface)
 {
     struct shstream *stream = impl_from_IStream(iface);
