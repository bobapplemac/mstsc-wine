From 7d205bed9a869abb781a0f206dd2bbfb35632bb6 Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sat, 14 Nov 2026 21:02:51 -0500
Subject: [PATCH 17/43] credui: Keep generic user names as typed in the
 credential dialog.

The dialog completed a user name without a domain with the target name
("target\user") even for CREDUI_FLAGS_GENERIC_CREDENTIALS.
CredUIPromptForWindowsCredentialsW passes its caption as the target, so
the Remote Desktop client got back "Enter your credentials\Administrator"
for "Administrator" and saved that name.  Only domain credentials are
completed now.

Co-Authored-By: Andrew J. Moore <andrew@forevermoore.net>
---
 dlls/credui/credui_main.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/dlls/credui/credui_main.c b/dlls/credui/credui_main.c
index c752be0..bb8c47b 100644
--- a/dlls/credui/credui_main.c
+++ b/dlls/credui/credui_main.c
@@ -454,7 +454,9 @@ static void CredDialogCommandOk(HWND hwndDlg, struct cred_dialog_params *params)
         return;
     }
 
-    if (!wcschr(user, '\\') && !wcschr(user, '@'))
+    /* generic credentials keep the user name as typed; only domain credentials are
+     * completed with the target name */
+    if (!(params->dwFlags & CREDUI_FLAGS_GENERIC_CREDENTIALS) && !wcschr(user, '\\') && !wcschr(user, '@'))
     {
         ULONG len_target = lstrlenW(params->pszTargetName);
         memcpy(params->pszUsername, params->pszTargetName,
-- 
2.47.3

