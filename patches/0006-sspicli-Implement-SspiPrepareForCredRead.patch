From 732dcafe434455540cbbac26fc515de425939593 Mon Sep 17 00:00:00 2001
From: "Andrew J. Moore" <andrew@forevermoore.net>
Date: Sat, 14 Nov 2026 10:10:44 -0500
Subject: [PATCH 6/6] sspicli: Implement SspiPrepareForCredRead.

mstscax.dll (Remote Desktop client) calls it before looking up saved
credentials for a connection target.  Return the target name copy (or
domain\user from the identity) with CRED_TYPE_DOMAIN_PASSWORD, mirroring
SspiPrepareForCredWrite.
---
 dlls/secur32/secur32.spec    |  1 +
 dlls/secur32/tests/secur32.c | 33 +++++++++++++++++++++++++++
 dlls/sspicli/main.c          | 43 ++++++++++++++++++++++++++++++++++++
 dlls/sspicli/sspicli.spec    |  2 +-
 include/sspi.h               |  1 +
 5 files changed, 79 insertions(+), 1 deletion(-)

diff --git a/dlls/secur32/secur32.spec b/dlls/secur32/secur32.spec
index c4824d3..4b4f1cf 100644
--- a/dlls/secur32/secur32.spec
+++ b/dlls/secur32/secur32.spec
@@ -73,6 +73,7 @@
 @ stdcall SspiEncodeStringsAsAuthIdentity(wstr wstr wstr ptr) sspicli.SspiEncodeStringsAsAuthIdentity
 @ stdcall SspiFreeAuthIdentity(ptr) sspicli.SspiFreeAuthIdentity
 @ stdcall SspiLocalFree(ptr) sspicli.SspiLocalFree
+@ stdcall SspiPrepareForCredRead(ptr wstr ptr ptr) sspicli.SspiPrepareForCredRead
 @ stdcall SspiPrepareForCredWrite(ptr wstr ptr ptr ptr ptr ptr) sspicli.SspiPrepareForCredWrite
 @ stdcall SspiZeroAuthIdentity(ptr) sspicli.SspiZeroAuthIdentity
 @ stdcall TranslateNameA(str long long ptr ptr)
diff --git a/dlls/secur32/tests/secur32.c b/dlls/secur32/tests/secur32.c
index 72a5dde..1c02fc7 100644
--- a/dlls/secur32/tests/secur32.c
+++ b/dlls/secur32/tests/secur32.c
@@ -46,6 +46,8 @@ static void (SEC_ENTRY *pSspiLocalFree)
     (void *);
 static SECURITY_STATUS (SEC_ENTRY *pSspiPrepareForCredWrite)
     (PSEC_WINNT_AUTH_IDENTITY_OPAQUE, PCWSTR, PULONG, PCWSTR *, PCWSTR *, PUCHAR *, PULONG);
+static SECURITY_STATUS (SEC_ENTRY *pSspiPrepareForCredRead)
+    (PSEC_WINNT_AUTH_IDENTITY_OPAQUE, PCWSTR, PULONG, PCWSTR *);
 static void (SEC_ENTRY *pSspiZeroAuthIdentity)
     (PSEC_WINNT_AUTH_IDENTITY_OPAQUE);
 
@@ -415,6 +417,35 @@ static void test_SspiPrepareForCredWrite(void)
     pSspiFreeAuthIdentity( id );
 }
 
+static void test_SspiPrepareForCredRead(void)
+{
+    static const WCHAR targetW[] = L"TERMSRV/rdp-test.invalid";
+    PSEC_WINNT_AUTH_IDENTITY_OPAQUE id;
+    SECURITY_STATUS status;
+    const WCHAR *target;
+    ULONG type;
+
+    if (!pSspiPrepareForCredRead)
+    {
+        win_skip( "SspiPrepareForCredRead not exported by secur32.dll\n" );
+        return;
+    }
+
+    status = pSspiEncodeStringsAsAuthIdentity( L"username", L"domainname", L"password", &id );
+    ok( status == SEC_E_OK, "got %08lx\n", status );
+
+    type = 0;
+    target = NULL;
+    status = pSspiPrepareForCredRead( id, targetW, &type, &target );
+    ok( status == SEC_E_OK, "got %08lx\n", status );
+    ok( type == CRED_TYPE_DOMAIN_PASSWORD, "got %lu\n", type );
+    ok( target && !lstrcmpW( target, targetW ), "got %s\n", wine_dbgstr_w(target) );
+    ok( target != targetW, "target was not copied\n" );
+    pSspiLocalFree( (void *)target );
+
+    pSspiFreeAuthIdentity( id );
+}
+
 static void test_kerberos(void)
 {
     SecPkgInfoA *info;
@@ -516,6 +547,7 @@ START_TEST(secur32)
         pSspiFreeAuthIdentity = (void *)GetProcAddress(secdll, "SspiFreeAuthIdentity");
         pSspiLocalFree = (void *)GetProcAddress(secdll, "SspiLocalFree");
         pSspiPrepareForCredWrite = (void *)GetProcAddress(secdll, "SspiPrepareForCredWrite");
+        pSspiPrepareForCredRead = (void *)GetProcAddress(secdll, "SspiPrepareForCredRead");
         pSspiZeroAuthIdentity = (void *)GetProcAddress(secdll, "SspiZeroAuthIdentity");
         pGetComputerObjectNameA = (PVOID)GetProcAddress(secdll, "GetComputerObjectNameA");
         pGetComputerObjectNameW = (PVOID)GetProcAddress(secdll, "GetComputerObjectNameW");
@@ -547,6 +579,7 @@ START_TEST(secur32)
         test_InitSecurityInterface();
         test_SspiEncodeStringsAsAuthIdentity();
         test_SspiPrepareForCredWrite();
+        test_SspiPrepareForCredRead();
 
         FreeLibrary(secdll);
     }
diff --git a/dlls/sspicli/main.c b/dlls/sspicli/main.c
index 2190fc5..188e8da 100644
--- a/dlls/sspicli/main.c
+++ b/dlls/sspicli/main.c
@@ -133,6 +133,49 @@ void SEC_ENTRY SspiLocalFree( void *ptr )
     free( ptr );
 }
 
+/***********************************************************************
+ *		SspiPrepareForCredRead (SECUR32.0)
+ */
+SECURITY_STATUS SEC_ENTRY SspiPrepareForCredRead( PSEC_WINNT_AUTH_IDENTITY_OPAQUE opaque_id,
+    PCWSTR target, PULONG type, PCWSTR *targetname )
+{
+    SEC_WINNT_AUTH_IDENTITY_W *id = (SEC_WINNT_AUTH_IDENTITY_W *)opaque_id;
+    WCHAR *str;
+    ULONG len;
+
+    FIXME( "%p %s %p %p semi-stub\n", opaque_id, debugstr_w(target), type, targetname );
+
+    if (!type || !targetname) return SEC_E_INVALID_PARAMETER;
+
+    if (target) str = wcsdup( target );
+    else if (id && id->DomainLength)
+    {
+        len = (id->DomainLength + id->UserLength + 2) * sizeof(WCHAR);
+        if ((str = malloc( len )))
+        {
+            memcpy( str, id->Domain, id->DomainLength * sizeof(WCHAR) );
+            str[id->DomainLength] = '\\';
+            memcpy( str + id->DomainLength + 1, id->User, id->UserLength * sizeof(WCHAR) );
+            str[id->DomainLength + 1 + id->UserLength] = 0;
+        }
+    }
+    else if (id && id->User)
+    {
+        len = (id->UserLength + 1) * sizeof(WCHAR);
+        if ((str = malloc( len )))
+        {
+            memcpy( str, id->User, id->UserLength * sizeof(WCHAR) );
+            str[id->UserLength] = 0;
+        }
+    }
+    else return SEC_E_INVALID_PARAMETER;
+    if (!str) return SEC_E_INSUFFICIENT_MEMORY;
+
+    *type = CRED_TYPE_DOMAIN_PASSWORD;
+    *targetname = str;
+    return SEC_E_OK;
+}
+
 /***********************************************************************
  *		SspiPrepareForCredWrite (SECUR32.0)
  */
