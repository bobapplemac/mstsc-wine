From a159b53817f9488ca751da4395a1057504109ccd Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sat, 14 Nov 2026 23:25:24 -0500
Subject: [PATCH 21/43] credui: Do not prefill the password when asking again
 after a failed logon.

---
 dlls/credui/credui_main.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/dlls/credui/credui_main.c b/dlls/credui/credui_main.c
index ec3c137..10605f4 100644
--- a/dlls/credui/credui_main.c
+++ b/dlls/credui/credui_main.c
@@ -1232,6 +1232,8 @@ DWORD WINAPI CredUIPromptForWindowsCredentialsW( CREDUI_INFOW *info, DWORD error
         if (!CredUnPackAuthenticationBufferW( 0, (void *)in_buf, in_buf_size, username, &len_username,
                                               NULL, &len_domain, password, &len_password ))
             WARN( "could not unpack input credentials, error %lu\n", GetLastError() );
+        /* after a failed logon Windows asks for a new password: keep the user name only */
+        if (error) SecureZeroMemory( password, sizeof(password) );
     }
 
     /* The dialog asks for a user name and password; the caller decides whether to store
-- 
2.47.3

