+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "setupapi.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(devobj);
+
+/***********************************************************************
+ *      DevObjCreateDeviceInfoList (devobj.@)
+ *
+ * The first four parameters correspond to SetupDiCreateDeviceInfoListExW();
+ * the meaning of the fifth is unknown.
+ */
+HDEVINFO WINAPI DevObjCreateDeviceInfoList( const GUID *class, HWND parent, const WCHAR *machine,
+                                            void *reserved, void *unknown )
+{
+    TRACE( "%s %p %s %p %p\n", debugstr_guid(class), parent, debugstr_w(machine), reserved, unknown );
+
+    if (unknown) FIXME( "unknown parameter %p\n", unknown );
+    return SetupDiCreateDeviceInfoListExW( class, parent, machine, reserved );
+}
+
+/***********************************************************************
+ *      DevObjGetClassDevs (devobj.@)
+ *
+ * Adds the matching devices to an existing device information set, like
+ * SetupDiGetClassDevsExW() with a non-NULL DeviceInfoSet, and returns a BOOL.
+ */
+BOOL WINAPI DevObjGetClassDevs( HDEVINFO devinfo, const GUID *class, const WCHAR *enumstr,
+                                DWORD flags, const WCHAR *machine, void *reserved )
+{
+    HDEVINFO ret;
+
+    TRACE( "%p %s %s %#lx %s %p\n", devinfo, debugstr_guid(class), debugstr_w(enumstr), flags,
+           debugstr_w(machine), reserved );
+
+    if (!devinfo || devinfo == INVALID_HANDLE_VALUE)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    ret = SetupDiGetClassDevsExW( class, enumstr, NULL, flags, devinfo, machine, reserved );
+    return ret != INVALID_HANDLE_VALUE;
+}
