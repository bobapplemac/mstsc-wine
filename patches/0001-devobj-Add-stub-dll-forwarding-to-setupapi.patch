+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "setupapi.h"
+#include "initguid.h"
+#include "devguid.h"
+
+#include "wine/test.h"
+
+static HDEVINFO (WINAPI *pDevObjCreateDeviceInfoList)(const GUID *, HWND, const WCHAR *, void *, void *);
+static BOOL (WINAPI *pDevObjGetClassDevs)(HDEVINFO, const GUID *, const WCHAR *, DWORD, const WCHAR *, void *);
+static BOOL (WINAPI *pDevObjDestroyDeviceInfoList)(HDEVINFO);
+static BOOL (WINAPI *pDevObjEnumDeviceInfo)(HDEVINFO, DWORD, SP_DEVINFO_DATA *);
+
+static void test_class_devs(void)
+{
+    SP_DEVINFO_DATA data = {sizeof(data)};
+    HDEVINFO set;
+    BOOL ret;
+
+    set = pDevObjCreateDeviceInfoList(NULL, NULL, NULL, NULL, NULL);
+    ok(set != INVALID_HANDLE_VALUE, "DevObjCreateDeviceInfoList failed, error %lu\n", GetLastError());
+
+    /* Empty list. */
+    SetLastError(0xdeadbeef);
+    ret = pDevObjEnumDeviceInfo(set, 0, &data);
+    ok(!ret && GetLastError() == ERROR_NO_MORE_ITEMS, "got ret %d, error %lu\n", ret, GetLastError());
+
+    /* Adds to the existing set and returns a BOOL, not a new handle. */
+    ret = pDevObjGetClassDevs(set, &GUID_DEVCLASS_DISPLAY, NULL, DIGCF_PRESENT, NULL, NULL);
+    ok(ret == TRUE, "DevObjGetClassDevs returned %d, error %lu\n", ret, GetLastError());
+
+    ret = pDevObjGetClassDevs(set, NULL, NULL, DIGCF_ALLCLASSES, NULL, NULL);
+    ok(ret == TRUE, "DevObjGetClassDevs returned %d, error %lu\n", ret, GetLastError());
+    ret = pDevObjEnumDeviceInfo(set, 0, &data);
+    ok(ret, "expected at least one device, error %lu\n", GetLastError());
+
+    ret = pDevObjDestroyDeviceInfoList(set);
+    ok(ret, "DevObjDestroyDeviceInfoList failed, error %lu\n", GetLastError());
+}
+
+START_TEST(devobj)
+{
+    HMODULE mod = LoadLibraryA("devobj.dll");
+
+    if (!mod)
+    {
+        win_skip("devobj.dll not available\n");
+        return;
+    }
+#define GET(f) p##f = (void *)GetProcAddress(mod, #f); ok(!!p##f, #f " missing\n");
+    GET(DevObjCreateDeviceInfoList);
+    GET(DevObjGetClassDevs);
+    GET(DevObjDestroyDeviceInfoList);
+    GET(DevObjEnumDeviceInfo);
+#undef GET
+    test_class_devs();
+}
