--- /dev/null
+++ b/dlls/devobj/devobj.spec
@@ -0,0 +1,53 @@
+# Windows 8+ device object library.  The SetupDi* family in setupapi is built on
+# these exports on Windows.  Argument counts come from the x86 stdcall
+# decorations; where they match the public SetupDi* equivalent the export is
+# forwarded directly.
+
+@ stub DevObjBuildClassInfoList
+@ stub DevObjClassGuidsFromName
+@ stub DevObjClassNameFromGuid
+@ stub DevObjCreateDevRegKey
+@ stub DevObjCreateDeviceInfo
+@ stdcall DevObjCreateDeviceInfoList(ptr long wstr ptr ptr)
+@ stub DevObjCreateDeviceInterface
+@ stub DevObjCreateDeviceInterfaceRegKey
+@ stub DevObjDeleteAllInterfacesForDevice
+@ stub DevObjDeleteDevRegKey
+@ stub DevObjDeleteDevice
+@ stub DevObjDeleteDeviceInfo
+@ stub DevObjDeleteDeviceInterfaceData
+@ stub DevObjDeleteDeviceInterfaceRegKey
+@ stdcall DevObjDestroyDeviceInfoList(ptr) setupapi.SetupDiDestroyDeviceInfoList
+@ stdcall DevObjEnumDeviceInfo(ptr long ptr) setupapi.SetupDiEnumDeviceInfo
+@ stdcall DevObjEnumDeviceInterfaces(ptr ptr ptr long ptr) setupapi.SetupDiEnumDeviceInterfaces
+@ stub DevObjGetClassDescription
+@ stdcall DevObjGetClassDevs(ptr ptr wstr long wstr ptr)
+@ stub DevObjGetClassProperty
+@ stub DevObjGetClassPropertyKeys
+@ stub DevObjGetClassRegistryProperty
+@ stub DevObjGetDeviceInfoDetail
+@ stub DevObjGetDeviceInfoListClass
+@ stub DevObjGetDeviceInfoListDetail
+@ stdcall DevObjGetDeviceInstanceId(ptr ptr ptr long ptr) setupapi.SetupDiGetDeviceInstanceIdW
+@ stub DevObjGetDeviceInterfaceAlias
+@ stdcall DevObjGetDeviceInterfaceDetail(ptr ptr ptr long ptr ptr) setupapi.SetupDiGetDeviceInterfaceDetailW
+@ stub DevObjGetDeviceInterfaceProperty
+@ stub DevObjGetDeviceInterfacePropertyKeys
+@ stdcall DevObjGetDeviceProperty(ptr ptr ptr ptr ptr long ptr long) setupapi.SetupDiGetDevicePropertyW
+@ stub DevObjGetDevicePropertyKeys
+@ stdcall DevObjGetDeviceRegistryProperty(ptr ptr long ptr ptr long ptr) setupapi.SetupDiGetDeviceRegistryPropertyW
+@ stub DevObjLocateDevice
+@ stdcall DevObjOpenClassRegKey(ptr long long wstr ptr) setupapi.SetupDiOpenClassRegKeyExW
+@ stdcall DevObjOpenDevRegKey(ptr ptr long long long long) setupapi.SetupDiOpenDevRegKey
+@ stdcall DevObjOpenDeviceInfo(ptr wstr ptr long ptr) setupapi.SetupDiOpenDeviceInfoW
+@ stdcall DevObjOpenDeviceInterface(ptr wstr long ptr) setupapi.SetupDiOpenDeviceInterfaceW
+@ stub DevObjOpenDeviceInterfaceRegKey
+@ stub DevObjRegisterDeviceInfo
+@ stub DevObjRemoveDeviceInterface
+@ stub DevObjSetClassProperty
+@ stub DevObjSetClassRegistryProperty
+@ stub DevObjSetDeviceInfoDetail
+@ stub DevObjSetDeviceInterfaceDefault
+@ stub DevObjSetDeviceInterfaceProperty
+@ stub DevObjSetDeviceProperty
+@ stub DevObjSetDeviceRegistryProperty
diff --git a/dlls/devobj/main.c b/dlls/devobj/main.c
new file mode 100644
index 0000000..8a55d7e
--- /dev/null
+++ b/dlls/devobj/main.c
@@ -0,0 +1,70 @@
