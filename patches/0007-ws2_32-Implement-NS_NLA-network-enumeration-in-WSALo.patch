+static void test_WSALookupService_NLA(void)
+{
+    static const GUID nla_class = { 0x0037e515, 0xb5c9, 0x4a43, { 0xba, 0xda, 0x8b, 0x48, 0xa8, 0x7a, 0xd2, 0x39 } };
+    char buffer[4096];
+    WSAQUERYSETW query, *qs = (WSAQUERYSETW *)buffer;
+    GUID class = nla_class;
+    HANDLE handle = NULL;
+    DWORD size, offset;
+    NLA_BLOB *nla;
+    int ret, count = 0, connectivity;
+
+    memset(&query, 0, sizeof(query));
+    query.dwSize = sizeof(query);
+    query.dwNameSpace = NS_NLA;
+    query.lpServiceClassId = &class;
+    ret = WSALookupServiceBeginW(&query, LUP_RETURN_ALL, &handle);
+    ok(!ret, "WSALookupServiceBeginW failed, error %u\n", WSAGetLastError());
+    if (ret) return;
+    ok(handle != NULL, "got NULL handle\n");
+
+    for (;;)
+    {
+        size = sizeof(*qs) - 1;
+        ret = WSALookupServiceNextW(handle, 0, &size, qs);
+        if (ret == SOCKET_ERROR && WSAGetLastError() == WSA_E_NO_MORE) break;
+        ok(ret == SOCKET_ERROR && WSAGetLastError() == WSAEFAULT, "got %d error %u\n", ret, WSAGetLastError());
+        ok(size > sizeof(*qs), "got required size %lu\n", size);
+        if (size > sizeof(buffer)) break;
+
+        ret = WSALookupServiceNextW(handle, 0, &size, qs);
+        ok(!ret, "WSALookupServiceNextW failed, error %u\n", WSAGetLastError());
+        if (ret) break;
+        count++;
+        ok(qs->dwNameSpace == NS_NLA, "got namespace %lu\n", qs->dwNameSpace);
+        ok(qs->lpServiceClassId && IsEqualGUID(qs->lpServiceClassId, &nla_class), "got class %s\n",
+           qs->lpServiceClassId ? wine_dbgstr_guid(qs->lpServiceClassId) : "(null)");
+        ok(qs->lpszServiceInstanceName != NULL, "got NULL network name\n");
+        ok(qs->lpBlob != NULL, "got NULL blob\n");
+        if (!qs->lpBlob) continue;
+
+        offset = 0;
+        connectivity = 0;
+        do
+        {
+            ok(offset + sizeof(nla->header) <= qs->lpBlob->cbSize, "offset %lu out of range\n", offset);
+            nla = (NLA_BLOB *)(qs->lpBlob->pBlobData + offset);
+            if (nla->header.type == NLA_CONNECTIVITY) connectivity++;
+            offset += nla->header.nextOffset;
+        } while (nla->header.nextOffset);
+        ok(connectivity <= 1, "got %d connectivity entries\n", connectivity);
+    }
+    trace("%d network(s)\n", count);
+
+    ret = WSALookupServiceEnd(handle);
+    ok(!ret, "WSALookupServiceEnd failed, error %u\n", WSAGetLastError());
+    ret = WSALookupServiceEnd(handle);
+    ok(ret == SOCKET_ERROR && WSAGetLastError() == WSA_INVALID_HANDLE, "got %d error %u\n", ret, WSAGetLastError());
+}
