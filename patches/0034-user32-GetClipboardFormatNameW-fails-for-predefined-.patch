From 7ae28dd0cb45add8c46b1b35ae0cf0598e950635 Mon Sep 17 00:00:00 2001
From: mstsc-wine <mstsc-wine@localhost>
Date: Sun, 15 Nov 2026 18:09:44 -0500
Subject: [PATCH 34/38] user32: GetClipboardFormatNameW fails for predefined
 formats.

It forwarded straight to NtUserGetClipboardFormatName(), which returns
integer atom names such as "#13" for CF_UNICODETEXT. Windows (and our
GetClipboardFormatNameA) return 0 for ids below 0xc000. Remote Desktop
puts these names into its clipboard format lists, where predefined
formats must have empty names.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/user32/clipboard.c       | 11 +++++++++++
 dlls/user32/tests/clipboard.c | 10 ++++++++++
 dlls/user32/user32.spec       |  2 +-
 3 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/dlls/user32/clipboard.c b/dlls/user32/clipboard.c
index f2b6ac92..94a4641d 100644
--- a/dlls/user32/clipboard.c
+++ b/dlls/user32/clipboard.c
@@ -553,6 +553,17 @@ UINT WINAPI RegisterClipboardFormatA( LPCSTR name )
 }
 
 
+/**************************************************************************
+ *		GetClipboardFormatNameW (USER32.@)
+ */
+INT WINAPI GetClipboardFormatNameW( UINT format, LPWSTR buffer, INT maxlen )
+{
+    /* predefined formats have no name */
+    if (format < MAXINTATOM || format > 0xffff) return 0;
+    return NtUserGetClipboardFormatName( format, buffer, maxlen );
+}
+
+
 /**************************************************************************
  *		GetClipboardFormatNameA (USER32.@)
  */
diff --git a/dlls/user32/tests/clipboard.c b/dlls/user32/tests/clipboard.c
index 828d7164..8279d076 100644
--- a/dlls/user32/tests/clipboard.c
+++ b/dlls/user32/tests/clipboard.c
@@ -481,6 +481,16 @@ static void test_RegisterClipboardFormatA(void)
             trace("%04x: %s\n", format_id, len ? buf : "");
     }
 
+    for (format_id = 0; format_id < 0x10fff; format_id++)
+    {
+        WCHAR bufW[256];
+        SetLastError(0xdeadbeef);
+        len = GetClipboardFormatNameW(format_id, bufW, ARRAY_SIZE(bufW));
+
+        if (format_id < 0xc000 || format_id > 0xffff)
+            ok(!len, "GetClipboardFormatNameW should fail, but it returned %d (%s)\n", len, wine_dbgstr_w(bufW));
+    }
+
     ret = open_clipboard(0);
     ok( ret, "OpenClipboard error %ld\n", GetLastError());
 
diff --git a/dlls/user32/user32.spec b/dlls/user32/user32.spec
index 16a4c6cb..866a7afb 100644
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -532,7 +532,7 @@
 # @ stub GetClipboardAccessToken
 @ stdcall GetClipboardData(long)
 @ stdcall GetClipboardFormatNameA(long ptr long)
-@ stdcall GetClipboardFormatNameW(long ptr long) NtUserGetClipboardFormatName
+@ stdcall GetClipboardFormatNameW(long ptr long)
 @ stdcall GetClipboardOwner() NtUserGetClipboardOwner
 @ stdcall GetClipboardSequenceNumber() NtUserGetClipboardSequenceNumber
 @ stdcall GetClipboardViewer() NtUserGetClipboardViewer
